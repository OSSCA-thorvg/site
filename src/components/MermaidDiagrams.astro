---
// Render Mermaid blocks inside `.prose` and update them when the theme changes.
---
<script>
  const mermaidBlocks = Array.from(
    document.querySelectorAll<HTMLElement>('.prose pre[data-language="mermaid"]')
  );

  if (mermaidBlocks.length) {
    const { default: mermaid } = await import('mermaid');
    const root = document.documentElement;
    const diagrams = mermaidBlocks.map((block) => {
      const host = document.createElement('div');
      host.className = 'mermaid-diagram';
      host.setAttribute('aria-label', 'Mermaid 다이어그램');
      block.replaceWith(host);
      return { host, source: block.textContent || '' };
    });
    let rendering = false;
    let queued = false;

    const renderMermaid = async () => {
      if (rendering) {
        queued = true;
        return;
      }
      rendering = true;
      const styles = getComputedStyle(root);
      const color = (token: string) => styles.getPropertyValue(token).trim();
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'base',
        fontFamily: styles.getPropertyValue('--font-body').trim(),
        themeVariables: {
          darkMode: root.dataset.theme === 'dark',
          background: color('--canvas'),
          primaryColor: color('--surface-1'),
          primaryTextColor: color('--ink'),
          primaryBorderColor: color('--hairline-strong'),
          secondaryColor: color('--surface-2'),
          tertiaryColor: color('--canvas'),
          secondaryTextColor: color('--ink'),
          tertiaryTextColor: color('--ink'),
          secondaryBorderColor: color('--hairline-strong'),
          tertiaryBorderColor: color('--hairline'),
          lineColor: color('--ink-subtle'),
          textColor: color('--ink'),
          mainBkg: color('--surface-1'),
          nodeBorder: color('--hairline-strong'),
          clusterBkg: color('--canvas'),
          clusterBorder: color('--hairline'),
          edgeLabelBackground: color('--canvas'),
          actorBkg: color('--surface-1'),
          actorBorder: color('--hairline-strong'),
          actorTextColor: color('--ink'),
          actorLineColor: color('--ink-subtle'),
          signalColor: color('--ink-subtle'),
          signalTextColor: color('--ink'),
          labelBoxBkgColor: color('--surface-1'),
          labelBoxBorderColor: color('--hairline-strong'),
          labelTextColor: color('--ink'),
          noteBkgColor: color('--surface-2'),
          noteBorderColor: color('--hairline'),
          noteTextColor: color('--ink'),
          activationBkgColor: color('--primary-subtle'),
          activationBorderColor: color('--primary'),
          fontSize: '15px',
        },
      });

      for (const { host, source } of diagrams) {
        host.classList.remove('mermaid-diagram--error');
        host.removeAttribute('data-processed');
        host.textContent = source;
        try {
          await mermaid.run({ nodes: [host], suppressErrors: true });
        } catch {
          host.classList.add('mermaid-diagram--error');
          host.textContent = source;
        }
      }

      rendering = false;
      if (queued) {
        queued = false;
        await renderMermaid();
      }
    };

    await renderMermaid();
    new MutationObserver(() => { void renderMermaid(); }).observe(root, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }
</script>
