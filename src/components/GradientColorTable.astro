<section class="gradient-table" data-gradient-table aria-label="Gradient Color Table 실습">
  <div class="gradient-table__lookup">
    <div class="gradient-table__canvas-wrap">
      <canvas data-table-canvas width="1024" height="20" aria-hidden="true"></canvas>
      <div class="gradient-table__markers" aria-hidden="true">
        <span data-marker="0">1</span>
        <span data-marker="1">2</span>
        <span data-marker="2">3</span>
      </div>
      <label class="gradient-table__table-control">
        <span class="sr-only">Color Table에서 확인할 t 값</span>
        <input data-index-range type="range" min="0" max="1023" value="512" aria-label="Color Table에서 확인할 t 값" />
      </label>
    </div>
    <output class="gradient-table__sample" data-sample aria-live="polite">
      <span><small>INDEX</small><b data-index>512</b></span>
      <span><small>t</small><b data-t>0.500</b></span>
      <span><small>COLOR</small><b data-hex-output>#000000</b></span>
      <span class="gradient-table__sample-color" data-sample-color aria-hidden="true"></span>
      <span class="gradient-table__rgb" data-rgb>rgb(0, 0, 0)</span>
    </output>
  </div>

  <div class="gradient-table__controls" aria-label="Color Stop 설정">
    <fieldset class="gradient-stop" data-stop>
      <legend class="sr-only">Color Stop 1</legend>
      <label class="gradient-stop__color">
        <span>Color 1</span>
        <input data-color type="color" value="#ff5a36" aria-label="Color Stop 1 색상" />
        <input data-hex type="text" value="#FF5A36" maxlength="7" pattern="#[0-9A-Fa-f]{6}" spellcheck="false" aria-label="Color Stop 1 HEX 값" />
      </label>
      <label class="gradient-stop__offset">
        <span>Offset <output data-offset>0.00</output></span>
        <input data-offset-range type="range" min="0" max="100" value="0" aria-label="Color Stop 1 offset" />
      </label>
    </fieldset>

    <fieldset class="gradient-stop" data-stop>
      <legend class="sr-only">Color Stop 2</legend>
      <label class="gradient-stop__color">
        <span>Color 2</span>
        <input data-color type="color" value="#ffd166" aria-label="Color Stop 2 색상" />
        <input data-hex type="text" value="#FFD166" maxlength="7" pattern="#[0-9A-Fa-f]{6}" spellcheck="false" aria-label="Color Stop 2 HEX 값" />
      </label>
      <label class="gradient-stop__offset">
        <span>Offset <output data-offset>0.50</output></span>
        <input data-offset-range type="range" min="0" max="100" value="50" aria-label="Color Stop 2 offset" />
      </label>
    </fieldset>

    <fieldset class="gradient-stop" data-stop>
      <legend class="sr-only">Color Stop 3</legend>
      <label class="gradient-stop__color">
        <span>Color 3</span>
        <input data-color type="color" value="#176bff" aria-label="Color Stop 3 색상" />
        <input data-hex type="text" value="#176BFF" maxlength="7" pattern="#[0-9A-Fa-f]{6}" spellcheck="false" aria-label="Color Stop 3 HEX 값" />
      </label>
      <label class="gradient-stop__offset">
        <span>Offset <output data-offset>1.00</output></span>
        <input data-offset-range type="range" min="0" max="100" value="100" aria-label="Color Stop 3 offset" />
      </label>
    </fieldset>
  </div>

</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-gradient-table]').forEach((root) => {
    const stopFields = Array.from(root.querySelectorAll<HTMLElement>('[data-stop]'));
    const canvas = root.querySelector<HTMLCanvasElement>('[data-table-canvas]');
    const indexRange = root.querySelector<HTMLInputElement>('[data-index-range]');
    const indexOutput = root.querySelector<HTMLElement>('[data-index]');
    const tOutput = root.querySelector<HTMLElement>('[data-t]');
    const hexOutput = root.querySelector<HTMLElement>('[data-hex-output]');
    const rgbOutput = root.querySelector<HTMLElement>('[data-rgb]');
    const sampleColor = root.querySelector<HTMLElement>('[data-sample-color]');
    const markers = Array.from(root.querySelectorAll<HTMLElement>('[data-marker]'));
    const context = canvas?.getContext('2d');
    const table = new Uint8ClampedArray(1024 * 4);

    if (!canvas || !context || !indexRange || !indexOutput || !tOutput || !hexOutput || !rgbOutput || !sampleColor) return;

    const parseHex = (hex: string) => ({
      r: Number.parseInt(hex.slice(1, 3), 16),
      g: Number.parseInt(hex.slice(3, 5), 16),
      b: Number.parseInt(hex.slice(5, 7), 16),
    });

    const toHex = (r: number, g: number, b: number) => `#${[r, g, b]
      .map((channel) => Math.round(channel).toString(16).padStart(2, '0'))
      .join('')}`.toUpperCase();

    const readStops = () => stopFields.map((field) => {
      const color = field.querySelector<HTMLInputElement>('[data-color]');
      const offset = field.querySelector<HTMLInputElement>('[data-offset-range]');
      return {
        hex: color?.value ?? '#000000',
        offset: Number(offset?.value ?? 0) / 100,
      };
    });

    const colorAt = (t: number, stops: ReturnType<typeof readStops>) => {
      if (t <= stops[0].offset) return parseHex(stops[0].hex);
      if (t >= stops[stops.length - 1].offset) return parseHex(stops[stops.length - 1].hex);

      const rightIndex = stops.findIndex((stop) => stop.offset >= t);
      const left = stops[rightIndex - 1];
      const right = stops[rightIndex];
      const span = right.offset - left.offset;
      const ratio = span === 0 ? 0 : (t - left.offset) / span;
      const from = parseHex(left.hex);
      const to = parseHex(right.hex);

      return {
        r: from.r + (to.r - from.r) * ratio,
        g: from.g + (to.g - from.g) * ratio,
        b: from.b + (to.b - from.b) * ratio,
      };
    };

    const showIndex = (value: number) => {
      const index = Math.max(0, Math.min(1023, Math.round(value)));
      const offset = index * 4;
      const r = table[offset];
      const g = table[offset + 1];
      const b = table[offset + 2];
      const hex = toHex(r, g, b);

      indexRange.value = String(index);
      indexOutput.textContent = String(index);
      tOutput.textContent = (index / 1023).toFixed(3);
      hexOutput.textContent = hex;
      rgbOutput.textContent = `rgb(${r}, ${g}, ${b})`;
      sampleColor.style.backgroundColor = hex;
    };

    const update = () => {
      const stops = readStops();

      stops.forEach((stop, index) => {
        if (markers[index]) markers[index].style.left = `${stop.offset * 100}%`;
        const offsetOutput = stopFields[index].querySelector<HTMLOutputElement>('[data-offset]');
        if (offsetOutput) offsetOutput.value = stop.offset.toFixed(2);
      });

      for (let index = 0; index < 1024; index += 1) {
        const color = colorAt(index / 1023, stops);
        const offset = index * 4;
        table[offset] = Math.round(color.r);
        table[offset + 1] = Math.round(color.g);
        table[offset + 2] = Math.round(color.b);
        table[offset + 3] = 255;
      }

      const image = context.createImageData(1024, 20);
      for (let row = 0; row < 20; row += 1) image.data.set(table, row * table.length);
      context.putImageData(image, 0, 0);
      showIndex(Number(indexRange.value));
    };

    stopFields.forEach((field, index) => {
      const color = field.querySelector<HTMLInputElement>('[data-color]');
      const hex = field.querySelector<HTMLInputElement>('[data-hex]');
      const offset = field.querySelector<HTMLInputElement>('[data-offset-range]');

      color?.addEventListener('input', () => {
        if (hex) hex.value = color.value.toUpperCase();
        update();
      });

      hex?.addEventListener('input', () => {
        if (/^#[0-9a-f]{6}$/i.test(hex.value) && color) {
          color.value = hex.value;
          update();
        }
      });

      hex?.addEventListener('blur', () => {
        if (color) hex.value = color.value.toUpperCase();
      });

      offset?.addEventListener('input', () => {
        const previous = stopFields[index - 1]?.querySelector<HTMLInputElement>('[data-offset-range]');
        const next = stopFields[index + 1]?.querySelector<HTMLInputElement>('[data-offset-range]');
        const minimum = Number(previous?.value ?? 0);
        const maximum = Number(next?.value ?? 100);
        offset.value = String(Math.max(minimum, Math.min(maximum, Number(offset.value))));
        update();
      });
    });

    indexRange.addEventListener('input', () => showIndex(Number(indexRange.value)));

    update();
  });
</script>

<style>
  .gradient-table {
    margin: var(--space-lg) 0 var(--space-xl);
    overflow: hidden;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    color: var(--ink);
  }

  .gradient-table__markers span {
    position: absolute;
    z-index: 2;
    top: 50%;
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    border: 1px solid #fff;
    border-radius: var(--radius-full);
    background: #171719;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 10px;
    font-style: normal;
    line-height: 1;
    pointer-events: none;
    transform: translate(-50%, -50%);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
  }

  .gradient-table__lookup { padding: var(--space-sm) var(--space-md) var(--space-md); }

  .gradient-table__canvas-wrap {
    position: relative;
    height: 20px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-sm);
  }

  .gradient-table__canvas-wrap canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }

  .gradient-table__table-control {
    position: absolute;
    z-index: 3;
    inset: -4px 0;
    display: block;
  }

  .gradient-table__table-control input {
    width: 100%;
    height: 28px;
    margin: 0;
    appearance: none;
    background: transparent;
    cursor: ew-resize;
  }

  .gradient-table__table-control input::-webkit-slider-runnable-track { height: 20px; background: transparent; }
  .gradient-table__table-control input::-webkit-slider-thumb {
    width: 5px;
    height: 28px;
    margin-top: -4px;
    appearance: none;
    border: 1px solid rgba(0, 0, 0, 0.55);
    border-radius: 2px;
    background: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }
  .gradient-table__table-control input::-moz-range-track { height: 20px; background: transparent; }
  .gradient-table__table-control input::-moz-range-thumb {
    width: 3px;
    height: 26px;
    border: 1px solid rgba(0, 0, 0, 0.55);
    border-radius: 2px;
    background: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .gradient-table__sample {
    min-height: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-xs);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .gradient-table__sample > span { flex: 0 0 auto; white-space: nowrap; display: flex; align-items: baseline; gap: 5px; }
  .gradient-table__sample small { color: var(--ink-subtle); font-size: 12px; letter-spacing: 0.08em; }
  .gradient-table__sample b { color: var(--ink); font-weight: 600; }
  .gradient-table__sample .gradient-table__sample-color { width: 18px; height: 18px; flex: none; border: 1px solid var(--hairline-strong); border-radius: var(--radius-xs); }
  .gradient-table__sample .gradient-table__rgb { margin-left: auto; color: var(--ink-subtle); }

  .gradient-table__controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--hairline);
  }

  .gradient-stop {
    min-width: 0;
    padding: var(--space-md);
    border: 0;
  }

  .gradient-stop + .gradient-stop { border-left: 1px solid var(--hairline); }

  .gradient-stop label > span {
    color: var(--ink-subtle);
    font-size: 12px;
    font-weight: 600;
  }

  .gradient-stop__color {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    align-items: center;
    gap: 6px;
  }

  .gradient-stop__color > span { grid-column: 1 / -1; }

  .gradient-stop__color input[type="color"] {
    width: 28px;
    height: 28px;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--control-border);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
  }

  .gradient-stop__color input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
  .gradient-stop__color input[type="color"]::-webkit-color-swatch { border: 0; }

  .gradient-stop__color input[type="text"] {
    width: 100%;
    min-width: 0;
    height: 30px;
    padding: 4px 7px;
    border: 1px solid var(--control-border);
    border-radius: var(--radius-sm);
    background: var(--canvas);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
  }

  .gradient-stop__offset { display: grid; gap: 5px; margin-top: var(--space-sm); }
  .gradient-stop__offset > span { display: flex; justify-content: space-between; gap: var(--space-sm); }
  .gradient-stop__offset output { color: var(--ink); font-family: var(--font-mono); }
  .gradient-stop__offset input { width: 100%; accent-color: var(--primary); }

  @media (max-width: 640px) {
    .gradient-table__controls { grid-template-columns: minmax(0, 1fr); }
    .gradient-stop + .gradient-stop { border-top: 1px solid var(--hairline); border-left: 0; }
    .gradient-table__sample { flex-wrap: wrap; gap: 6px var(--space-md); }
    .gradient-table__sample .gradient-table__rgb { width: 100%; margin-left: 0; }
  }
</style>
