---
import SeriesTree from './SeriesTree.astro';
import type { PostSeries } from '../lib/post-series.js';

interface Props {
  series: PostSeries[];
  postCount: number;
  currentId?: string;
  desktopMin?: number;
}

const { series, currentId, desktopMin = 981 } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<aside class="blog-sidebar" aria-label="블로그 탐색">
  <details class="blog-sidebar__panel" data-blog-sidebar-panel data-desktop-min={desktopMin} open>
    <summary class="blog-sidebar__header">
      <svg class="blog-sidebar__icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 3.5h14v13H3zM7.5 3.5v13M10.5 7h3.5M10.5 10h3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span class="blog-sidebar__label">문서 탐색</span>
      <svg class="blog-sidebar__toggle" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </summary>
    <nav class="blog-sidebar__nav" aria-label="블로그와 시리즈">
      <a
        class:list={['blog-sidebar__all', { 'is-selected': !currentId }]}
        href={base + 'blog/'}
        aria-current={!currentId ? 'page' : undefined}
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 2.5h4v4h-4zM9.5 2.5h4v4h-4zM2.5 9.5h4v4h-4zM9.5 9.5h4v4h-4z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" /></svg>
        <span>전체 글</span>
      </a>
      <div class="blog-sidebar__series-list">
        {series.map((item, index) => (
          <SeriesTree series={item} currentId={currentId} defaultOpen={!currentId && index === 0} />
        ))}
      </div>
    </nav>
  </details>
</aside>

<script>
  import {
    decodeFragment,
    findHeadingAlias,
    findNavigationTarget,
  } from '../lib/fragment-navigation.js';

  const sidebarPanels = document.querySelectorAll<HTMLDetailsElement>('[data-blog-sidebar-panel]');

  for (const panel of sidebarPanels) {
    const desktopMin = Number(panel.dataset.desktopMin) || 981;
    const desktopSidebar = window.matchMedia(`(min-width: ${desktopMin}px)`);
    const header = panel.querySelector<HTMLElement>('.blog-sidebar__header');
    const syncSidebarPanel = () => {
      panel.open = desktopSidebar.matches;
      if (header) header.tabIndex = desktopSidebar.matches ? -1 : 0;
    };

    const nav = panel.querySelector<HTMLElement>('.blog-sidebar__nav');
    const groups = [...panel.querySelectorAll<HTMLDetailsElement>('[data-series-path]')];
    const storageKey = 'ossca-series-navigation';
    const scrollKey = 'ossca-series-scroll';
    const readScroll = () => {
      try {
        const value = sessionStorage.getItem(scrollKey);
        const offset = value === null ? NaN : Number(value);
        return Number.isFinite(offset) && offset >= 0 ? offset : null;
      } catch { return null; }
    };
    let savedScroll = readScroll();
    let positioned = false;
    let saved: Record<string, boolean> = {};
    try {
      const value = JSON.parse(sessionStorage.getItem(storageKey) || '{}');
      if (value && typeof value === 'object' && !Array.isArray(value)) saved = value;
    } catch { /* Navigation also works when storage is unavailable. */ }

    for (const group of groups) {
      const path = group.dataset.seriesPath!;
      if (group.classList.contains('is-current')) group.open = true;
      else if (typeof saved[path] === 'boolean') group.open = saved[path];
      group.addEventListener('toggle', () => {
        try {
          sessionStorage.setItem(storageKey, JSON.stringify(Object.fromEntries(
            groups.map((item) => [item.dataset.seriesPath, item.open]),
          )));
        } catch { /* Keep the native disclosure behavior without storage. */ }
      });
    }

    const saveScroll = () => {
      if (!positioned || !panel.open || !nav?.clientHeight) return;
      savedScroll = nav.scrollTop;
      try { sessionStorage.setItem(scrollKey, String(savedScroll)); } catch { /* Storage is optional. */ }
    };

    // Restore the reader's position first; reveal the current article only on a first visit.
    const restoreScroll = () => requestAnimationFrame(() => {
      if (!panel.open || !nav?.clientHeight) return;
      if (savedScroll !== null) nav.scrollTop = savedScroll;
      else {
        const current = nav.querySelector<HTMLElement>('a[aria-current="page"]');
        if (current) {
          const item = current.getBoundingClientRect();
          const viewport = nav.getBoundingClientRect();
          if (item.top < viewport.top || item.bottom > viewport.bottom) {
            nav.scrollTop += item.top - viewport.top - (nav.clientHeight - item.height) / 2;
          }
        }
      }
      positioned = true;
      saveScroll();
    });
    nav?.addEventListener('scroll', saveScroll, { passive: true });
    nav?.addEventListener('click', saveScroll, { capture: true });
    window.addEventListener('pagehide', saveScroll);
    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      savedScroll = readScroll();
      restoreScroll();
    });
    panel.addEventListener('toggle', restoreScroll);
    if (nav) new ResizeObserver(restoreScroll).observe(nav);

    const resolveDocumentFragment = () => {
      const fragment = decodeFragment(window.location.hash);
      if (!fragment) return;

      const headingIds = [...document.querySelectorAll<HTMLElement>('.prose [id]')]
        .map((heading) => heading.id)
        .filter(Boolean);
      const headingAlias = findHeadingAlias(fragment, headingIds);

      if (headingAlias) {
        if (headingAlias !== fragment) {
          const destination = new URL(window.location.href);
          destination.hash = headingAlias;
          window.location.replace(destination);
        }
        return;
      }

      const currentGroups = groups.filter((group) => group.classList.contains('is-current')).reverse();
      for (const group of currentGroups) {
        const links = [...group.querySelectorAll<HTMLAnchorElement>('a[data-series-topic]')]
          .filter((link) => link.getAttribute('aria-current') !== 'page')
          .map((link) => ({
            label: link.dataset.seriesTopic || '',
            href: link.href,
          }));
        const target = findNavigationTarget(fragment, links);
        if (!target) continue;

        const destination = new URL(target, window.location.href);
        const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
        const destinationPath = destination.pathname.replace(/\/+$/, '') || '/';
        if (destinationPath !== currentPath) {
          // A cached redirect can send the destination back to this missing fragment.
          // Allow one automatic attempt per source URL in this tab, never a loop.
          const attemptKey = `ossca-fragment-navigation:${window.location.href}`;
          try {
            if (sessionStorage.getItem(attemptKey) === destination.href) return;
            sessionStorage.setItem(attemptKey, destination.href);
          } catch {
            // Without persistent state we cannot detect a cross-page redirect cycle.
            return;
          }
          window.location.replace(destination);
        }
        return;
      }
    };

    syncSidebarPanel();
    restoreScroll();
    resolveDocumentFragment();
    window.addEventListener('hashchange', resolveDocumentFragment);
    desktopSidebar.addEventListener('change', () => {
      syncSidebarPanel();
      restoreScroll();
    });
  }
</script>
