---
const { src, title } = Astro.props;
const base = import.meta.env.BASE_URL;
const pdfUrl = `${base}${src.replace(/^\/+/, '')}`;
---

<section
  class="pdf-slides"
  aria-labelledby="pdf-slides-title"
  data-pdf-slides
  data-pdf-url={pdfUrl}
  data-title={title}
>
  <header class="pdf-slides__header">
    <div>
      <span class="pdf-slides__eyebrow">Presentation</span>
      <h2 id="pdf-slides-title">{title}</h2>
    </div>
    <a class="pdf-slides__open" href={pdfUrl} target="_blank" rel="noopener noreferrer">
      PDF 열기 <span aria-hidden="true">↗</span>
    </a>
  </header>

  <div class="pdf-slides__stage" data-stage aria-busy="true">
    <canvas data-canvas aria-label={`${title} 1페이지`}></canvas>
    <p class="pdf-slides__status" data-status role="status">슬라이드를 불러오는 중…</p>
  </div>

  <footer class="pdf-slides__controls" aria-label="슬라이드 페이지 이동">
    <button type="button" data-previous disabled>
      <span aria-hidden="true">←</span> 이전
    </button>
    <span class="pdf-slides__page" aria-live="polite">
      <strong data-current>1</strong><span aria-hidden="true"> / </span><span class="sr-only">페이지, 전체 </span><span data-total>–</span>
    </span>
    <button type="button" data-next disabled>
      다음 <span aria-hidden="true">→</span>
    </button>
  </footer>

  <noscript>
    <p class="pdf-slides__fallback">슬라이드를 보려면 JavaScript를 켜거나 <a href={pdfUrl}>PDF 파일을 열어 주세요.</a></p>
  </noscript>
</section>

<script>
  import { GlobalWorkerOptions, getDocument } from 'pdfjs-dist';
  import pdfWorkerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';

  GlobalWorkerOptions.workerSrc = pdfWorkerUrl;

  document.querySelectorAll('[data-pdf-slides]').forEach(async (viewer) => {
    if (!(viewer instanceof HTMLElement)) return;

    const pdfUrl = viewer.dataset.pdfUrl;
    const title = viewer.dataset.title ?? 'PDF 슬라이드';
    const stage = viewer.querySelector('[data-stage]');
    const canvas = viewer.querySelector('[data-canvas]');
    const status = viewer.querySelector('[data-status]');
    const previous = viewer.querySelector('[data-previous]');
    const next = viewer.querySelector('[data-next]');
    const current = viewer.querySelector('[data-current]');
    const total = viewer.querySelector('[data-total]');

    if (
      !pdfUrl
      || !(stage instanceof HTMLElement)
      || !(canvas instanceof HTMLCanvasElement)
      || !(status instanceof HTMLElement)
      || !(previous instanceof HTMLButtonElement)
      || !(next instanceof HTMLButtonElement)
      || !(current instanceof HTMLElement)
      || !(total instanceof HTMLElement)
    ) return;

    let pageNumber = 1;
    let lastWidth = 0;
    let rendering = false;
    let rerenderRequested = false;
    let resizeTimer = 0;

    const showLoading = () => {
      stage.setAttribute('aria-busy', 'true');
      previous.disabled = true;
      next.disabled = true;
      status.hidden = false;
    };

    const hideLoading = () => {
      stage.setAttribute('aria-busy', 'false');
      previous.disabled = pageNumber === 1;
      next.disabled = false;
      status.hidden = true;
    };

    const showError = () => {
      stage.setAttribute('aria-busy', 'false');
      const link = document.createElement('a');
      link.href = pdfUrl;
      link.textContent = 'PDF 파일을 열어 주세요.';
      status.hidden = false;
      status.replaceChildren('슬라이드를 표시할 수 없습니다. ', link);
    };

    try {
      const pdf = await getDocument(pdfUrl).promise;
      total.textContent = String(pdf.numPages);

      const renderPage = async () => {
        if (rendering) {
          rerenderRequested = true;
          return;
        }

        rendering = true;
        showLoading();
        status.textContent = `${pageNumber}페이지를 불러오는 중…`;

        try {
          const page = await pdf.getPage(pageNumber);
          const initialViewport = page.getViewport({ scale: 1 });
          const width = stage.clientWidth;
          const viewport = page.getViewport({ scale: width / initialViewport.width });
          const outputScale = Math.min(window.devicePixelRatio || 1, 2);
          const context = canvas.getContext('2d');
          if (!context) throw new Error('Canvas is not available');

          lastWidth = width;
          canvas.width = Math.floor(viewport.width * outputScale);
          canvas.height = Math.floor(viewport.height * outputScale);
          canvas.style.width = `${Math.floor(viewport.width)}px`;
          canvas.style.height = `${Math.floor(viewport.height)}px`;

          await page.render({
            canvas,
            canvasContext: context,
            viewport,
            transform: outputScale === 1 ? undefined : [outputScale, 0, 0, outputScale, 0, 0],
          }).promise;

          current.textContent = String(pageNumber);
          canvas.setAttribute('aria-label', `${title} ${pageNumber}페이지`);
          stage.classList.add('is-ready');
          hideLoading();
          next.disabled = pageNumber === pdf.numPages;
        } finally {
          rendering = false;
          if (rerenderRequested) {
            rerenderRequested = false;
            await renderPage();
          }
        }
      };

      previous.addEventListener('click', () => {
        if (pageNumber <= 1) return;
        pageNumber -= 1;
        void renderPage().catch(showError);
      });

      next.addEventListener('click', () => {
        if (pageNumber >= pdf.numPages) return;
        pageNumber += 1;
        void renderPage().catch(showError);
      });

      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          if (Math.abs(stage.clientWidth - lastWidth) > 1) void renderPage().catch(showError);
        }, 150);
      });

      await renderPage();
    } catch {
      showError();
    }
  });
</script>

<style>
  .pdf-slides {
    width: min(640px, 100%);
    margin: 0 auto 3rem;
    overflow: hidden;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    box-shadow: var(--shadow-floating);
  }

  .pdf-slides__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--hairline);
  }

  .pdf-slides__eyebrow {
    display: block;
    margin-bottom: 2px;
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pdf-slides h2 {
    margin: 0;
    font-size: 14px;
    line-height: 1.35;
  }

  .pdf-slides__open {
    flex: none;
    color: var(--primary);
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  .pdf-slides__open:hover {
    color: var(--primary-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pdf-slides__stage {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #202124;
  }

  .pdf-slides__stage:not(.is-ready) {
    aspect-ratio: 16 / 9;
  }

  .pdf-slides__stage canvas {
    display: block;
    max-width: 100%;
    height: auto;
    opacity: 0;
    transition: opacity var(--dur-micro) var(--ease-out);
  }

  .pdf-slides__stage.is-ready canvas {
    opacity: 1;
  }

  .pdf-slides__status {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: var(--space-lg);
    color: #e8eaed;
    font-size: 12px;
    text-align: center;
  }

  .pdf-slides__status[hidden] {
    display: none;
  }

  .pdf-slides__status :global(a) {
    color: #8ab4f8;
    text-decoration: underline;
  }

  .pdf-slides__controls {
    min-height: 42px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-sm);
    padding: 5px var(--space-sm);
    border-top: 1px solid var(--hairline);
  }

  .pdf-slides__controls button {
    min-height: 30px;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    font-size: 11px;
    font-weight: 600;
  }

  .pdf-slides__controls button:first-child {
    justify-self: start;
  }

  .pdf-slides__controls button:last-child {
    justify-self: end;
  }

  .pdf-slides__controls button:hover:not(:disabled) {
    background: var(--surface-2);
    color: var(--primary);
  }

  .pdf-slides__controls button:disabled {
    color: var(--ink-faint);
    cursor: not-allowed;
  }

  .pdf-slides__page {
    color: var(--ink-subtle);
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .pdf-slides__page strong {
    color: var(--ink);
  }

  .pdf-slides__fallback {
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    border-top: 1px solid var(--hairline);
    color: var(--ink-subtle);
    font-size: 11px;
  }

  @media (max-width: 560px) {
    .pdf-slides__header {
      align-items: flex-start;
    }

    .pdf-slides h2 {
      font-size: 13px;
    }
  }
</style>
