---
import GradientLabHeader from './GradientLabHeader.astro';
---
<section class="linear-lab fill-lab" data-linear-lab aria-label="ThorVG Linear Gradient 실습">
  <GradientLabHeader icon="linear" title="Linear Gradient" description="시작점·끝점·샘플 픽셀을 움직이며 색이 결정되는 과정을 살펴보세요." />
  <span class="sr-only" data-status aria-live="polite">렌더러 준비 중</span>

  <div class="linear-lab__stage" data-stage>
    <canvas data-canvas width="680" height="360" aria-label="조작 가능한 Linear Gradient 결과"></canvas>
    <svg data-overlay viewBox="0 0 680 360" role="img" aria-label="Gradient 축과 픽셀 투영 위치">
      <defs>
        <pattern id="linear-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1" />
        </pattern>
        <linearGradient data-table-gradient gradientUnits="userSpaceOnUse">
          <stop data-table-stop="0" offset="0" stop-color="#ff5a36"></stop>
          <stop data-table-stop="1" offset="0.5" stop-color="#ffd166"></stop>
          <stop data-table-stop="2" offset="1" stop-color="#176bff"></stop>
        </linearGradient>
      </defs>
      <rect class="linear-lab__grid" width="680" height="360" fill="url(#linear-grid)"></rect>
      <line class="linear-lab__axis-shadow" data-axis-shadow></line>
      <line class="linear-lab__table-axis" data-table-axis></line>
      <line class="linear-lab__axis" data-axis></line>
      <line class="linear-lab__sample-vector" data-sample-vector></line>
      <line class="linear-lab__projection" data-projection></line>
      <path class="linear-lab__right-angle" data-right-angle></path>
      <circle class="linear-lab__projected" data-projected r="4"></circle>
      <circle class="linear-lab__lookup-marker" data-lookup-marker r="7"></circle>

      <text class="linear-lab__diagram-label" data-table-label>Color Table</text>
      <text class="linear-lab__diagram-label" data-vector-label>d = p2 − p1</text>
      <text class="linear-lab__diagram-label" data-relative-label>p − p1</text>
      <text class="linear-lab__diagram-label linear-lab__diagram-label--t" data-projected-label>p1 + t·d</text>

      <g class="linear-lab__stop-marker" data-stop-marker="0" aria-hidden="true"><circle r="7"></circle></g>
      <g class="linear-lab__stop-marker" data-stop-marker="1" aria-hidden="true"><circle r="7"></circle></g>
      <g class="linear-lab__stop-marker" data-stop-marker="2" aria-hidden="true"><circle r="7"></circle></g>

      <g class="linear-lab__handle linear-lab__handle--start" data-handle="p1" tabindex="0" role="slider" aria-label="시작점 P1">
        <circle r="13"></circle>
        <text x="0" y="4">P1</text>
      </g>
      <g class="linear-lab__handle linear-lab__handle--end" data-handle="p2" tabindex="0" role="slider" aria-label="끝점 P2">
        <circle r="13"></circle>
        <text x="0" y="4">P2</text>
      </g>
      <g class="linear-lab__handle linear-lab__handle--sample" data-handle="sample" tabindex="0" role="slider" aria-label="샘플 픽셀 P">
        <circle r="11"></circle>
        <path d="M -5 0 H 5 M 0 -5 V 5"></path>
        <text x="17" y="4">P</text>
      </g>
    </svg>
    <p class="linear-lab__hint">점을 드래그하거나 방향키로 이동</p>
  </div>

  <div class="linear-lab__metrics" aria-live="polite">
    <span><small>d = p2 − p1</small><b data-vector>(420, 150)</b></span>
    <span><small>p − p1</small><b data-relative>(225, −27)</b></span>
    <span class="linear-lab__equation"><small>dot(p − p1, d) / dot(d, d)</small><b data-equation>90,450 / 198,900 = 0.455</b></span>
    <span><small data-spread-formula>u = clamp(t, 0, 1)</small><b data-lookup-t></b></span>
    <span><small>Table index</small><b data-index>512</b></span>
    <i data-sample-color aria-hidden="true"></i>
  </div>

  <div class="linear-lab__controls">
    <fieldset class="linear-lab__stops">
      <legend class="sr-only">Color Stops</legend>
      <label class="linear-lab__stop">
        <input data-color="0" type="color" value="#ff5a36" aria-label="시작 Color Stop" />
        <span>
          <output data-offset-output>0.00</output>
          <input data-offset type="range" min="0" max="100" value="0" aria-label="Color Stop 1 offset" />
        </span>
      </label>
      <label class="linear-lab__stop">
        <input data-color="1" type="color" value="#ffd166" aria-label="중간 Color Stop" />
        <span>
          <output data-offset-output>0.50</output>
          <input data-offset type="range" min="0" max="100" value="50" aria-label="Color Stop 2 offset" />
        </span>
      </label>
      <label class="linear-lab__stop">
        <input data-color="2" type="color" value="#176bff" aria-label="끝 Color Stop" />
        <span>
          <output data-offset-output>1.00</output>
          <input data-offset type="range" min="0" max="100" value="100" aria-label="Color Stop 3 offset" />
        </span>
      </label>
    </fieldset>

    <label class="linear-lab__spread">
      <span>범위 처리</span>
      <select data-spread aria-label="Linear Gradient 범위 처리">
        <option value="Pad">Pad · 끝 색 유지</option>
        <option value="Repeat">Repeat · 반복</option>
        <option value="Reflect">Reflect · 왕복</option>
      </select>
    </label>
    <button class="linear-lab__reset" data-reset type="button">초기화</button>
  </div>

  <p class="linear-lab__caption">캔버스 전체를 덮는 Shape에 Linear Gradient를 적용한 결과입니다.</p>

  <ul class="linear-lab__note">
    <li><b>P1/P2</b>: Gradient 축의 시작점/끝점</li>
    <li><b>P</b>: 샘플 픽셀</li>
    <li><b>축의 색상 띠</b>: Color Table</li>
    <li><b>원형 마커</b>: Color Stop</li>
    <li><b>벡터 선</b>: <code>p - p1</code></li>
    <li><b>점선</b>: 축으로의 사영</li>
    <li><b>투영점</b>: <code>p1 + t·d</code></li>
    <li><b>조회 마커</b>: 범위 처리 후 <code>u</code>의 테이블 위치</li>
  </ul>
</section>

<script>
  import ThorVG from '@thorvg/webcanvas';
  import { spreadT, spreadFormula, drawGradientPreview } from '../lib/gradient-spread.mjs';
  type SpreadMode = 'Pad' | 'Repeat' | 'Reflect';
  import wasmUrl from '../../node_modules/@thorvg/webcanvas/dist/thorvg.wasm?url';

  const WIDTH = 680;
  const HEIGHT = 360;
  const initialPoints = {
    p1: { x: 130, y: 105 },
    p2: { x: 550, y: 255 },
    sample: { x: 355, y: 78 },
  };

  type PointName = keyof typeof initialPoints;
  type Point = { x: number; y: number };
  type LinearLabElement = HTMLElement & { __linearLabCleanup?: () => void };

  type ThorVGGlobal = typeof globalThis & {
    __thorvgSwPromise?: ReturnType<typeof ThorVG.init>;
  };

  const thorvgGlobal = globalThis as ThorVGGlobal;
  const loadThorVG = () => thorvgGlobal.__thorvgSwPromise ??= ThorVG.init({ renderer: 'sw', locateFile: (file) => file.endsWith('.wasm') ? wasmUrl : file });

  const parseHex = (hex: string) => [
    Number.parseInt(hex.slice(1, 3), 16),
    Number.parseInt(hex.slice(3, 5), 16),
    Number.parseInt(hex.slice(5, 7), 16),
    255,
  ] as const;

  const mixHex = (fromHex: string, toHex: string, ratio: number) => {
    const from = parseHex(fromHex);
    const to = parseHex(toHex);
    const channels = [0, 1, 2].map((index) => Math.round(from[index] + (to[index] - from[index]) * ratio));
    return `rgb(${channels.join(', ')})`;
  };

  document.querySelectorAll<HTMLElement>('[data-linear-lab]').forEach((rootElement, rootIndex) => {
    const root = rootElement as LinearLabElement;
    root.__linearLabCleanup?.();
    delete root.dataset.initialized;
    const controller = new AbortController();
    const listenerOptions = { signal: controller.signal };

    const canvasElement = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const overlay = root.querySelector<SVGSVGElement>('[data-overlay]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const vectorOutput = root.querySelector<HTMLElement>('[data-vector]')!;
    const relativeOutput = root.querySelector<HTMLElement>('[data-relative]')!;
    const equationOutput = root.querySelector<HTMLElement>('[data-equation]')!;
    const indexOutput = root.querySelector<HTMLElement>('[data-index]')!;
    const sampleColor = root.querySelector<HTMLElement>('[data-sample-color]')!;
    const resetButton = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const spreadSelect = root.querySelector<HTMLSelectElement>('[data-spread]')!;
    const spreadMode = () => spreadSelect.value as SpreadMode;
    const spreadCaption = root.querySelector<HTMLElement>('[data-spread-formula]')!;
    const colorInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-color]'));
    const offsetInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-offset]'));
    const offsetOutputs = Array.from(root.querySelectorAll<HTMLOutputElement>('[data-offset-output]'));
    const stopMarkers = Array.from(root.querySelectorAll<SVGGElement>('[data-stop-marker]'));
    const tableGradient = root.querySelector<SVGLinearGradientElement>('[data-table-gradient]')!;
    const tableStops = Array.from(root.querySelectorAll<SVGStopElement>('[data-table-stop]'));
    const tableAxis = root.querySelector<SVGLineElement>('[data-table-axis]')!;
    const axisLines = Array.from(root.querySelectorAll<SVGLineElement>('[data-axis], [data-axis-shadow], [data-table-axis]'));
    const sampleVector = root.querySelector<SVGLineElement>('[data-sample-vector]')!;
    const projection = root.querySelector<SVGLineElement>('[data-projection]')!;
    const rightAngle = root.querySelector<SVGPathElement>('[data-right-angle]')!;
    const projected = root.querySelector<SVGCircleElement>('[data-projected]')!;
    const lookupMarker = root.querySelector<SVGCircleElement>('[data-lookup-marker]')!;
    const lookupOutput = root.querySelector<HTMLElement>('[data-lookup-t]')!;
    const tableLabel = root.querySelector<SVGTextElement>('[data-table-label]')!;
    const vectorLabel = root.querySelector<SVGTextElement>('[data-vector-label]')!;
    const relativeLabel = root.querySelector<SVGTextElement>('[data-relative-label]')!;
    const projectedLabel = root.querySelector<SVGTextElement>('[data-projected-label]')!;
    const handles = Array.from(root.querySelectorAll<SVGGElement>('[data-handle]'));

    canvasElement.id = `thorvg-linear-gradient-${rootIndex}`;
    tableGradient.id = `thorvg-linear-table-${rootIndex}`;
    tableAxis.setAttribute('stroke', `url(#${tableGradient.id})`);

    const points: Record<PointName, Point> = structuredClone(initialPoints);
    let activePoint: PointName | undefined;
    let frame = 0;
    let renderFrame = () => drawFallback();
    let disposeRenderer = () => {};

    root.__linearLabCleanup = () => {
      controller.abort();
      cancelAnimationFrame(frame);
      disposeRenderer();
    };

    const colors = () => colorInputs.map((input) => input.value);
    const offsets = () => offsetInputs.map((input) => Number(input.value) / 100);

    function gradientT(point: Point) {
      const dx = points.p2.x - points.p1.x;
      const dy = points.p2.y - points.p1.y;
      const relativeX = point.x - points.p1.x;
      const relativeY = point.y - points.p1.y;
      const denominator = dx * dx + dy * dy;
      const numerator = relativeX * dx + relativeY * dy;
      if (denominator < 0.0001) return { dx, dy, relativeX, relativeY, numerator, denominator, t: 1, valid: false };
      return { dx, dy, relativeX, relativeY, numerator, denominator, t: numerator / denominator, valid: true };
    }

    function drawFallback() {
      const context = canvasElement.getContext('2d');
      if (!context) return;
      if (!gradientT(points.sample).valid) {
        context.fillStyle = colors().at(-1)!;
        context.fillRect(0, 0, WIDTH, HEIGHT);
        return;
      }
      drawGradientPreview(context, WIDTH, HEIGHT,
        colors().map((color, i) => ({ color, offset: offsets()[i] })),
        (x, y) => { const result = gradientT({ x, y }); return result.valid ? result.t : NaN; }, spreadMode());
    }

    function scheduleRender() {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(renderFrame);
    }

    function setLine(line: SVGLineElement, from: Point, to: Point) {
      line.setAttribute('x1', String(from.x));
      line.setAttribute('y1', String(from.y));
      line.setAttribute('x2', String(to.x));
      line.setAttribute('y2', String(to.y));
    }

    function setLabel(label: SVGTextElement, point: Point, content?: string) {
      label.setAttribute('x', String(point.x));
      label.setAttribute('y', String(point.y));
      if (content) label.textContent = content;
    }

    function updateOverlay(rerender = true) {
      const result = gradientT(points.sample);
      const projectedPoint = result.valid
        ? { x: points.p1.x + result.dx * result.t, y: points.p1.y + result.dy * result.t }
        : points.p1;
      const length = Math.sqrt(result.denominator);
      const perpendicular = result.valid
        ? { x: -result.dy / length, y: result.dx / length }
        : { x: 0, y: -1 };
      const projectionSide = (points.sample.x - projectedPoint.x) * perpendicular.x
        + (points.sample.y - projectedPoint.y) * perpendicular.y < 0 ? -1 : 1;
      const axisLabelSide = -projectionSide;

      axisLines.forEach((line) => {
        setLine(line, points.p1, points.p2);
      });

      tableGradient.setAttribute('x1', String(points.p1.x));
      tableGradient.setAttribute('y1', String(points.p1.y));
      tableGradient.setAttribute('x2', String(points.p2.x));
      tableGradient.setAttribute('y2', String(points.p2.y));
      setLine(sampleVector, points.p1, points.sample);
      setLine(projection, points.sample, projectedPoint);

      projected.setAttribute('cx', String(projectedPoint.x));
      projected.setAttribute('cy', String(projectedPoint.y));

      if (result.valid) {
        const angleSize = 9;
        const alongAxis = { x: result.dx / length, y: result.dy / length };
        const towardSampleLength = Math.hypot(points.sample.x - projectedPoint.x, points.sample.y - projectedPoint.y);
        const towardSample = towardSampleLength > 0.0001
          ? { x: (points.sample.x - projectedPoint.x) / towardSampleLength, y: (points.sample.y - projectedPoint.y) / towardSampleLength }
          : perpendicular;
        const corner1 = { x: projectedPoint.x + alongAxis.x * angleSize, y: projectedPoint.y + alongAxis.y * angleSize };
        const corner2 = { x: corner1.x + towardSample.x * angleSize, y: corner1.y + towardSample.y * angleSize };
        const corner3 = { x: projectedPoint.x + towardSample.x * angleSize, y: projectedPoint.y + towardSample.y * angleSize };
        rightAngle.setAttribute('d', `M ${corner1.x} ${corner1.y} L ${corner2.x} ${corner2.y} L ${corner3.x} ${corner3.y}`);
      } else {
        rightAngle.removeAttribute('d');
      }

      handles.forEach((handle) => {
        const name = handle.dataset.handle as PointName;
        const point = points[name];
        handle.setAttribute('transform', `translate(${point.x} ${point.y})`);
        handle.setAttribute('aria-valuetext', `x ${Math.round(point.x)}, y ${Math.round(point.y)}`);
      });

      const clampedT = result.valid ? spreadT(result.t, spreadMode()) : 1;
      spreadCaption.textContent = spreadFormula(spreadMode());
      lookupOutput.textContent = clampedT.toFixed(3);
      lookupMarker.setAttribute('cx', String(points.p1.x + result.dx * clampedT));
      lookupMarker.setAttribute('cy', String(points.p1.y + result.dy * clampedT));
      lookupMarker.setAttribute('r', Math.abs(result.t - clampedT) > 1e-9 ? '18' : '7');
      const stopColors = colors();
      const stopOffsets = offsets();

      tableStops.forEach((stop, index) => {
        stop.setAttribute('offset', String(stopOffsets[index]));
        stop.setAttribute('stop-color', stopColors[index]);
      });

      stopMarkers.forEach((marker, index) => {
        const offset = stopOffsets[index];
        marker.setAttribute('transform', `translate(${points.p1.x + result.dx * offset} ${points.p1.y + result.dy * offset})`);
        marker.style.setProperty('--stop-color', stopColors[index]);
        offsetOutputs[index].value = offset.toFixed(2);
      });

      let previewColor = stopColors[stopColors.length - 1];
      if (clampedT <= stopOffsets[0]) {
        previewColor = stopColors[0];
      } else {
        const rightIndex = stopOffsets.findIndex((offset) => offset >= clampedT);
        if (rightIndex > 0) {
          const span = stopOffsets[rightIndex] - stopOffsets[rightIndex - 1];
          const ratio = span === 0 ? 0 : (clampedT - stopOffsets[rightIndex - 1]) / span;
          previewColor = mixHex(stopColors[rightIndex - 1], stopColors[rightIndex], ratio);
        }
      }

      const tableLabelPoint = {
        x: points.p1.x + result.dx * 0.32 + perpendicular.x * 20 * axisLabelSide,
        y: points.p1.y + result.dy * 0.32 + perpendicular.y * 20 * axisLabelSide,
      };
      const vectorLabelPoint = {
        x: points.p1.x + result.dx * 0.7 + perpendicular.x * 20 * axisLabelSide,
        y: points.p1.y + result.dy * 0.7 + perpendicular.y * 20 * axisLabelSide,
      };
      const relativeLabelPoint = {
        x: (points.p1.x + points.sample.x) * 0.5 + perpendicular.x * 14 * projectionSide,
        y: (points.p1.y + points.sample.y) * 0.5 + perpendicular.y * 14 * projectionSide,
      };
      const projectedLabelPoint = {
        x: projectedPoint.x + perpendicular.x * 28 * projectionSide,
        y: projectedPoint.y + perpendicular.y * 28 * projectionSide,
      };
      setLabel(tableLabel, tableLabelPoint);
      setLabel(vectorLabel, vectorLabelPoint);
      setLabel(relativeLabel, relativeLabelPoint);
      setLabel(projectedLabel, projectedLabelPoint, result.valid ? `p1 + ${result.t.toFixed(2)}d` : 'p1 = p2');

      vectorOutput.textContent = `(${Math.round(result.dx)}, ${Math.round(result.dy)})`;
      relativeOutput.textContent = `(${Math.round(result.relativeX)}, ${Math.round(result.relativeY)})`;
      equationOutput.textContent = result.valid
        ? `${Math.round(result.numerator).toLocaleString()} / ${Math.round(result.denominator).toLocaleString()} = ${result.t.toFixed(3)}`
        : '정의되지 않음 (P1 = P2)';
      indexOutput.textContent = result.valid ? String(Math.round(clampedT * 1023)) : 'solid';
      sampleColor.style.background = previewColor;

      if (rerender) scheduleRender();
    }

    function movePoint(name: PointName, x: number, y: number) {
      points[name].x = Math.max(18, Math.min(WIDTH - 18, x));
      points[name].y = Math.max(18, Math.min(HEIGHT - 18, y));
      updateOverlay(name !== 'sample');
    }

    function pointerPosition(event: PointerEvent) {
      const bounds = overlay.getBoundingClientRect();
      return {
        x: (event.clientX - bounds.left) * WIDTH / bounds.width,
        y: (event.clientY - bounds.top) * HEIGHT / bounds.height,
      };
    }

    overlay.addEventListener('pointerdown', (event) => {
      const handle = (event.target as Element).closest<SVGGElement>('[data-handle]');
      if (!handle) return;
      activePoint = handle.dataset.handle as PointName;
      overlay.setPointerCapture(event.pointerId);
      const point = pointerPosition(event);
      movePoint(activePoint, point.x, point.y);
    }, listenerOptions);

    overlay.addEventListener('pointermove', (event) => {
      if (!activePoint) return;
      const point = pointerPosition(event);
      movePoint(activePoint, point.x, point.y);
    }, listenerOptions);

    const stopDragging = (event: PointerEvent) => {
      if (overlay.hasPointerCapture(event.pointerId)) overlay.releasePointerCapture(event.pointerId);
      activePoint = undefined;
    };
    overlay.addEventListener('pointerup', stopDragging, listenerOptions);
    overlay.addEventListener('pointercancel', stopDragging, listenerOptions);

    handles.forEach((handle) => {
      handle.addEventListener('keydown', (event) => {
        const name = handle.dataset.handle as PointName;
        const step = event.shiftKey ? 12 : 3;
        const delta = {
          ArrowLeft: [-step, 0],
          ArrowRight: [step, 0],
          ArrowUp: [0, -step],
          ArrowDown: [0, step],
        }[event.key];
        if (!delta) return;
        event.preventDefault();
        movePoint(name, points[name].x + delta[0], points[name].y + delta[1]);
      }, listenerOptions);
    });

    spreadSelect.addEventListener('change', () => updateOverlay(), listenerOptions);

    colorInputs.forEach((input) => input.addEventListener('input', () => updateOverlay(), listenerOptions));
    offsetInputs.forEach((input, index) => input.addEventListener('input', () => {
      const previous = offsetInputs[index - 1];
      const next = offsetInputs[index + 1];
      const minimum = Number(previous?.value ?? 0);
      const maximum = Number(next?.value ?? 100);
      input.value = String(Math.max(minimum, Math.min(maximum, Number(input.value))));
      updateOverlay();
    }, listenerOptions));
    resetButton.addEventListener('click', () => {
      (Object.keys(initialPoints) as PointName[]).forEach((name) => Object.assign(points[name], initialPoints[name]));
      spreadSelect.value = 'Pad';
      const defaults = ['#ff5a36', '#ffd166', '#176bff'];
      colorInputs.forEach((input, index) => input.value = defaults[index]);
      offsetInputs.forEach((input, index) => input.value = String(index * 50));
      updateOverlay();
    }, listenerOptions);

    drawFallback();
    updateOverlay(false);

    const boot = () => {
      loadThorVG().then((TVG) => {
        if (controller.signal.aborted) return;
        const tvgCanvas = new TVG.Canvas(`#${canvasElement.id}`, {
          width: WIDTH,
          height: HEIGHT,
          enableDevicePixelRatio: false,
        });
        let currentShape: InstanceType<typeof TVG.Shape> | undefined;

        disposeRenderer = () => {
          cancelAnimationFrame(frame);
          if (currentShape) {
            tvgCanvas.remove(currentShape);
            currentShape.dispose();
            currentShape = undefined;
          }
          tvgCanvas.destroy();
        };

        renderFrame = () => {
          if (currentShape) {
            tvgCanvas.remove(currentShape);
            currentShape.dispose();
          }

          const gradient = new TVG.LinearGradient(points.p1.x, points.p1.y, points.p2.x, points.p2.y)
            .setStops(
              [Number(offsetInputs[0].value) / 100, parseHex(colorInputs[0].value)],
              [Number(offsetInputs[1].value) / 100, parseHex(colorInputs[1].value)],
              [Number(offsetInputs[2].value) / 100, parseHex(colorInputs[2].value)],
            );

          gradient.spread(TVG.GradientSpread[spreadMode()]);
          currentShape = new TVG.Shape().appendRect(0, 0, WIDTH, HEIGHT).fill(gradient);
          tvgCanvas.add(currentShape).render();
        };

        root.classList.add('is-ready');
        status.textContent = 'CPU Engine';
        scheduleRender();
      }).catch((error) => {
        console.error('ThorVG WebCanvas initialization failed', error);
        root.classList.add('has-error');
        status.textContent = 'Canvas fallback';
        status.title = 'ThorVG WebCanvas를 불러오지 못해 브라우저 Canvas 미리보기를 사용합니다.';
      });
    };

    boot();
  });
</script>

<style>
  .linear-lab__stage { position: relative; margin: 0 var(--lab-padding); aspect-ratio: 17 / 9; overflow: hidden; border: 1px solid var(--hairline); border-radius: 16px; background: var(--animation-canvas); isolation: isolate; }

  .linear-lab__stage canvas,
  .linear-lab__stage svg {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
  }

  .linear-lab__stage svg {
    z-index: 2;
    color: var(--animation-line);
    touch-action: none;
    user-select: none;
  }

  .linear-lab__grid { opacity: 0.16; pointer-events: none; }
  .linear-lab__axis-shadow { stroke: var(--animation-canvas); stroke-width: 18; stroke-linecap: round; pointer-events: none; }
  .linear-lab__table-axis { stroke-width: 12; stroke-linecap: round; pointer-events: none; }
  .linear-lab__axis { stroke: var(--animation-ink); stroke-width: 1; pointer-events: none; }
  .linear-lab__sample-vector { stroke: var(--animation-info); stroke-width: 1.5; pointer-events: none; }
  .linear-lab__projection { stroke: var(--animation-ink); stroke-width: 1.5; stroke-dasharray: 5 5; pointer-events: none; }
  .linear-lab__right-angle { fill: none; stroke: var(--animation-ink); stroke-width: 1.25; pointer-events: none; }
  .linear-lab__axis,
  .linear-lab__sample-vector,
  .linear-lab__projection,
  .linear-lab__right-angle {
    stroke-width: calc(var(--animation-stroke) * 1px);
    vector-effect: non-scaling-stroke;
  }
  .linear-lab__lookup-marker { fill: none; stroke: var(--animation-warning); stroke-width: 2; pointer-events: none; }
  .linear-lab__projected { fill: var(--animation-ink); stroke: var(--animation-canvas); stroke-width: 2; pointer-events: none; }
  .linear-lab__diagram-label {
    fill: var(--animation-ink);
    stroke: var(--animation-canvas);
    stroke-width: 3px;
    paint-order: stroke;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 650;
    text-anchor: middle;
    pointer-events: none;
  }
  .linear-lab__diagram-label--t { fill: var(--animation-ink); }
  .linear-lab__stop-marker { pointer-events: none; }
  .linear-lab__stop-marker circle {
    fill: var(--stop-color);
    stroke: var(--animation-ink);
    stroke-width: 2;
    filter: drop-shadow(0 1px 3px var(--animation-line));
  }

  .linear-lab__handle { cursor: grab; outline: none; }
  .linear-lab__handle:active { cursor: grabbing; }
  .linear-lab__handle circle { stroke: var(--animation-ink); stroke-width: 2; filter: drop-shadow(0 1px 3px color-mix(in srgb, var(--ink) 18%, transparent)); }
  .linear-lab__handle text { fill: var(--animation-ink); font-family: var(--font-mono); font-size: 12px; font-weight: 700; text-anchor: middle; pointer-events: none; }
  .linear-lab__handle--start circle,
  .linear-lab__handle--end circle { fill: var(--animation-canvas); }
  .linear-lab__handle--sample circle { fill: var(--animation-canvas); }
  .linear-lab__handle--sample path { fill: none; stroke: var(--animation-ink); stroke-width: 1.5; pointer-events: none; }
  .linear-lab__handle--sample text { font-size: 13px; text-anchor: start; }
  .linear-lab__handle:focus circle { stroke-width: 4; }

  .linear-lab__hint { position: absolute; z-index: 3; right: 12px; bottom: 12px; margin: 0; padding: 6px 10px; border: 0; border-radius: 999px; background: color-mix(in srgb, var(--animation-canvas) 94%, transparent); color: var(--animation-muted); font: 12px var(--font-body); }

  .linear-lab__metrics { min-height: 54px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; padding: 20px var(--lab-padding); border-bottom: 1px solid var(--hairline); background: var(--canvas); font-family: var(--font-mono); }

  .linear-lab__metrics span { flex: 1 1 max-content; min-width: 0; display: grid; gap: 1px; }
  .linear-lab__metrics small { color: var(--ink-subtle); font-size: 12px; letter-spacing: 0; }
  .linear-lab__metrics b { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; white-space: normal; }
  .linear-lab__metrics i { width: 22px; height: 22px; border: 1px solid var(--hairline-strong); border-radius: var(--radius-full); box-shadow: inset 0 0 0 2px var(--canvas); }

  .linear-lab__controls { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 20px; padding: 20px var(--lab-padding) var(--lab-padding); }

  .linear-lab__stops {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
    padding: 0;
    border: 0;
  }

  .linear-lab__stops { grid-column: 1 / -1; }
  .linear-lab__spread { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 13px; color: var(--ink-muted); min-width: 0; }
  .linear-lab__spread select { min-width: 0; max-width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid var(--hairline); border-radius: 12px; background: var(--surface-1); color: var(--ink); font: inherit; }

  .linear-lab__stop { min-width: 0; display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: center; gap: 12px; padding: 12px; border-radius: 14px; background: var(--surface-1); }

  .linear-lab__stop > span { min-width: 0; display: grid; gap: 3px; }
  .linear-lab__stop output { color: var(--ink-muted); font-family: var(--font-mono); font-size: 12px; font-variant-numeric: tabular-nums; }
  .linear-lab__stop input[type='range'] { width: 100%; min-width: 0; margin: 0; accent-color: var(--primary); }

  .linear-lab__controls input[type='color'] { width: 44px; height: 44px; padding: 0; overflow: hidden; border: 1px solid var(--hairline); border-radius: 12px; background: var(--canvas); cursor: pointer; }

  .linear-lab__controls input[type='color']::-webkit-color-swatch-wrapper { padding: 0; }
  .linear-lab__controls input[type='color']::-webkit-color-swatch { border: 0; }

  .linear-lab__reset { min-height: 44px; padding: 0 18px; border: 0; border-radius: 12px; background: var(--primary-subtle); color: var(--primary); font: 600 13px var(--font-body); cursor: pointer; }

  .linear-lab__reset { cursor: pointer; }
  .linear-lab__reset:hover { background: color-mix(in srgb, var(--primary) 15%, var(--canvas)); }

  .linear-lab__note { display: flex; flex-wrap: wrap; gap: 8px 22px; list-style: none; margin: 0 !important; padding: 16px var(--lab-padding); border-top: 1px solid var(--hairline); background: var(--surface-1); color: var(--ink-muted); font-size: 12px; line-height: 1.65; }

  .linear-lab__note b { color: var(--ink); }

  @media (max-width: 520px) {
    .linear-lab__diagram-label { font-size: 22px; }
    .linear-lab__diagram-label[data-table-label] { transform: translateX(-20px); }
    .linear-lab__handle text { font-size: 18px; }
    .linear-lab__handle--sample text { font-size: 20px; }
  }

  @media (max-width: 640px) {
    .linear-lab__controls { grid-template-columns: minmax(0, 1fr) auto; }
    .linear-lab__stops { grid-column: 1 / -1; grid-template-columns: minmax(0, 1fr); }
    .linear-lab__metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 12px; }
    .linear-lab__equation { grid-column: 1 / -1; flex-basis: 100%; }
    .linear-lab__metrics i { display: none; }
    .linear-lab__metrics small { font-size: 12px; }
    .linear-lab__hint { display: none; }
  }
  .linear-lab__caption { margin: 0 !important; padding: 0 var(--lab-padding) 16px; color: var(--ink-muted); font-size: 13px; line-height: 1.6; }
  .linear-lab__note li { margin: 0; padding: 0; }
</style>
