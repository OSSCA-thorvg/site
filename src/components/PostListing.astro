---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BlogSidebar from './BlogSidebar.astro';
import { extractFirstMedia, resolveBlogMediaUrl } from '../lib/blog-media.js';
import { sortPostTags } from '../lib/post-sections.js';
import { deriveSummary } from '../lib/summary.js';

interface SeriesEntry {
  id: string;
  title: string;
  number: number;
}

interface PostSeries {
  name: string;
  entries: SeriesEntry[];
}

interface Props {
  posts: CollectionEntry<'blog'>[];
  series?: PostSeries[];
  title: string;
  active: 'blog' | 'assignments';
  eyebrow: string;
  lede: string;
  categoryLabel: string;
  itemLabel: string;
  writeLabel: string;
  writeAriaLabel: string;
}

const {
  posts,
  series = [],
  title,
  active,
  eyebrow,
  lede,
  categoryLabel,
  itemLabel,
  writeLabel,
  writeAriaLabel,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const PAGE_SIZE = 12;
const mediaByPost = new Map(posts.map((post) => [post.id, extractFirstMedia(post.body)]));
const tags = sortPostTags(posts.flatMap((post) => post.data.tags));
const fmt = (date: Date) => date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---
<Base title={title} active={active}>
  <section class="section">
    <div class:list={{ 'blog-library': series.length > 0 }}>
      {series.length > 0 && (
        <BlogSidebar series={series} postCount={posts.length} />
      )}

      <div class:list={{ 'blog-library__content': series.length > 0 }}>
        <div class="container">
      <p class="eyebrow">{eyebrow}</p>
      <div class="blog-heading">
        <h1 class="page-title">{title}</h1>
        <div class="blog-heading__actions">
          <label class="blog-search"><span class="sr-only">글 검색</span>
            <input class="search" id="f-search" type="search" placeholder="글 검색" aria-controls="post-grid" />
          </label>
          <a
            class="btn btn--primary blog-write-link"
            href="https://github.com/OSSCA-thorvg/site/discussions/new?category=blog"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${writeAriaLabel} (새 창)`}
          >{writeLabel}</a>
        </div>
      </div>
      <p class="lede">{lede}</p>

      <nav class="blog-categories" aria-label={`${categoryLabel} 카테고리`}>
        <span class="blog-categories__label">카테고리</span>
        <button class="blog-category is-selected" type="button" data-tag="" aria-pressed="true">전체</button>
        {tags.map((tag) => <button class="blog-category" type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}
      </nav>
      <span
        class="result-count blog-result-count"
        id="b-count"
        data-item-label={itemLabel}
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >{posts.length}개 {itemLabel}</span>

      <div class="card-grid" id="post-grid">
        {posts.map((p) => {
          const media = mediaByPost.get(p.id);
          return (
          <article
            class="post-card"
            data-date={p.data.date.getTime()}
            data-year={p.data.date.getUTCFullYear()}
            data-tags={JSON.stringify(p.data.tags)}
            data-search={[
              p.data.title,
              p.data.summary || deriveSummary(p.body ?? ''),
              ...p.data.tags,
              p.data.github,
            ].join(' ').toLowerCase()}
          >
            <a
              class="post-card__link"
              href={base + 'blog/' + p.id}
              aria-label={`${p.data.title} 읽기`}
            ></a>
            <div class={`post-card__media ${media ? `post-card__media--${media.type}` : 'post-card__media--fallback'}`}>
              {media ? (
                media.type === 'lottie' ? (
                  <lottie-player
                    src={resolveBlogMediaUrl(media.src, p.id, base)}
                    data-blog-lottie
                    autoplay
                    loop
                    aria-label={media.alt || `${categoryLabel} Lottie 대표 이미지`}
                  ></lottie-player>
                ) : (
                  <img
                    src={resolveBlogMediaUrl(media.src, p.id, base)}
                    alt={media.alt}
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                )
              ) : (
                <img class="post-card__fallback-mark" src={base + 'thorvg-mark.svg'} alt="" width="96" height="96" />
              )}
            </div>
            <div class="post-card__meta">
              <a
                class="post-card__author"
                href={`https://github.com/${p.data.github}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`@${p.data.github} GitHub 프로필 (새 창)`}
              >
                <img
                  class="author-avatar"
                  src={`https://github.com/${p.data.github}.png?size=80`}
                  alt=""
                  width="32"
                  height="32"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
                <span class="post-card__author-copy">
                  <span class="post-card__author-name">@{p.data.github}</span>
                </span>
              </a>
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
            </div>
            <h2 class="post-card__heading">
              <span class="post-card__title">{p.data.title}</span>
            </h2>
          </article>
          );
        })}
      </div>
      <p class="empty-state" id="b-empty" hidden>조건에 맞는 {itemLabel}이 없습니다.</p>
      <nav
        class="pagination"
        id="post-pagination"
        aria-label={`${categoryLabel} 페이지`}
        aria-controls="post-grid"
        data-page-size={PAGE_SIZE}
        hidden
      >
        <button class="pagination__step" type="button" data-page-previous disabled>← 이전</button>
        <span class="pagination__pages" data-page-buttons role="group" aria-label="페이지 선택"></span>
        <span class="pagination__summary" data-page-summary aria-hidden="true"></span>
        <button class="pagination__step" type="button" data-page-next disabled>다음 →</button>
        <span class="sr-only" data-page-status role="status" aria-live="polite" aria-atomic="true"></span>
      </nav>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const players = [...document.querySelectorAll('[data-blog-lottie]')];
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const pauseWhenReady = (player) => {
        const pause = () => {
          if (player.totalFrame > 0) {
            player.pause();
            player.removeAttribute('autoplay');
            return true;
          }
          return false;
        };
        if (pause()) return;
        const started = Date.now();
        const timer = window.setInterval(() => {
          if (pause() || Date.now() - started > 5000) window.clearInterval(timer);
        }, 50);
      };

      players.forEach((player) => {
        const src = player.getAttribute('src');
        if (src) player.setAttribute('src', new URL(src, document.baseURI).href);

        const card = player.closest('.post-card');
        if (!card) return;

        card.addEventListener('mouseenter', () => player.play());
        card.addEventListener('mouseleave', () => player.pause());
        card.addEventListener('focusin', () => player.play());
        card.addEventListener('focusout', () => player.pause());
        if (reduceMotion) player.removeAttribute('autoplay');
      });

      if (!reduceMotion && window.customElements) {
        window.customElements.whenDefined('lottie-player').then(() => {
          players.forEach(pauseWhenReady);
        });
      }

      if (reduceMotion && window.customElements) {
        window.customElements.whenDefined('lottie-player').then(() => {
          players.forEach((player) => {
            player.setAttribute('autoplay', '');
            player.play();
            pauseWhenReady(player);
          });
        });
      }
    })();
  </script>

  <script>
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.post-card'));
    const search = document.getElementById('f-search') as HTMLInputElement;
    const categories = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tag]'));
    const count = document.getElementById('b-count')!;
    const empty = document.getElementById('b-empty')!;
    const grid = document.getElementById('post-grid')!;
    const pagination = document.getElementById('post-pagination')!;
    const previous = pagination.querySelector<HTMLButtonElement>('[data-page-previous]')!;
    const next = pagination.querySelector<HTMLButtonElement>('[data-page-next]')!;
    const pageButtons = pagination.querySelector<HTMLElement>('[data-page-buttons]')!;
    const pageSummary = pagination.querySelector<HTMLElement>('[data-page-summary]')!;
    const pageStatus = pagination.querySelector<HTMLElement>('[data-page-status]')!;
    const pageSize = Number(pagination.dataset.pageSize) || 12;
    const itemLabel = count.dataset.itemLabel || '글';
    let currentPage = pageFromUrl();
    let currentMatches = cards;

    function pageFromUrl() {
      const value = Number.parseInt(new URL(window.location.href).searchParams.get('page') || '1', 10);
      return Number.isFinite(value) && value > 0 ? value : 1;
    }

    function updatePageUrl(mode: 'push' | 'replace') {
      const url = new URL(window.location.href);
      if (currentPage === 1) url.searchParams.delete('page');
      else url.searchParams.set('page', String(currentPage));

      if (mode === 'push') window.history.pushState({}, '', url);
      else window.history.replaceState({}, '', url);
    }

    function pageItems(totalPages: number) {
      if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);

      const candidates = new Set([1, totalPages, currentPage - 1, currentPage, currentPage + 1]);
      if (currentPage <= 4) [2, 3, 4, 5].forEach((page) => candidates.add(page));
      if (currentPage >= totalPages - 3) {
        [totalPages - 4, totalPages - 3, totalPages - 2, totalPages - 1].forEach((page) => candidates.add(page));
      }

      const pages = [...candidates].filter((page) => page > 0 && page <= totalPages).sort((a, b) => a - b);
      const items: Array<number | null> = [];
      pages.forEach((page, index) => {
        if (index > 0 && page - pages[index - 1] > 1) items.push(null);
        items.push(page);
      });
      return items;
    }

    function renderPageButtons(totalPages: number) {
      pageButtons.replaceChildren();
      for (const page of pageItems(totalPages)) {
        if (page === null) {
          const ellipsis = document.createElement('span');
          ellipsis.className = 'pagination__ellipsis';
          ellipsis.textContent = '…';
          ellipsis.setAttribute('aria-hidden', 'true');
          pageButtons.appendChild(ellipsis);
          continue;
        }

        const button = document.createElement('button');
        button.className = 'pagination__page';
        button.type = 'button';
        button.dataset.page = String(page);
        button.textContent = String(page);
        button.setAttribute('aria-label', `${page}페이지`);
        if (page === currentPage) button.setAttribute('aria-current', 'page');
        pageButtons.appendChild(button);
      }
    }

    function renderPagination(historyMode?: 'push' | 'replace') {
      const totalItems = currentMatches.length;
      const totalPages = Math.ceil(totalItems / pageSize);
      const requestedPage = currentPage;
      currentPage = totalPages === 0 ? 1 : Math.min(Math.max(currentPage, 1), totalPages);

      const start = (currentPage - 1) * pageSize;
      const end = Math.min(start + pageSize, totalItems);
      currentMatches.forEach((card, index) => {
        card.hidden = index < start || index >= end;
      });

      pagination.hidden = totalPages <= 1;
      previous.disabled = currentPage <= 1;
      next.disabled = currentPage >= totalPages;
      pageSummary.textContent = totalPages > 0 ? `${currentPage} / ${totalPages}` : '';
      pageStatus.textContent = totalPages > 1
        ? `${totalPages}페이지 중 ${currentPage}페이지, ${start + 1}–${end}번째 ${itemLabel} 표시`
        : '';
      renderPageButtons(totalPages);
      if (historyMode) updatePageUrl(historyMode);
      else if (requestedPage !== currentPage) updatePageUrl('replace');
    }

    function scrollToGrid() {
      const top = grid.getBoundingClientRect().top + window.scrollY - 84;
      const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      window.scrollTo({ top: Math.max(0, top), behavior });
    }

    function goToPage(page: number, historyMode: 'push' | 'replace' = 'push') {
      const totalPages = Math.ceil(currentMatches.length / pageSize);
      const target = Math.min(Math.max(page, 1), totalPages || 1);
      if (target === currentPage) return;
      currentPage = target;
      renderPagination(historyMode);
      scrollToGrid();
    }

    function apply(resetPage = false) {
      const q = search.value.trim().toLowerCase();
      const selectedTag = categories.find((category) => category.getAttribute('aria-pressed') === 'true')?.dataset.tag || '';
      let shown = 0;
      const matchingCards: HTMLElement[] = [];

      for (const card of cards) {
        const matchesSearch = !q || (card.dataset.search || '').includes(q);
        const matchesTag = !selectedTag || JSON.parse(card.dataset.tags || '[]').includes(selectedTag);
        const matches = matchesSearch && matchesTag;

        card.hidden = !matches;
        if (matches) {
          matchingCards.push(card);
          shown++;
        }
      }

      currentMatches = matchingCards;
      if (resetPage) currentPage = 1;
      renderPagination(resetPage ? 'replace' : undefined);

      count.textContent = shown === 0
        ? `0개 ${itemLabel} · 조건에 맞는 ${itemLabel}이 없습니다.`
        : `${shown}개 ${itemLabel}`;
      empty.hidden = shown !== 0;
    }

    search.addEventListener('input', () => apply(true));
    categories.forEach((category) => category.addEventListener('click', () => {
      categories.forEach((item) => {
        const selected = item === category;
        item.classList.toggle('is-selected', selected);
        item.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      apply(true);
    }));

    previous.addEventListener('click', () => goToPage(currentPage - 1));
    next.addEventListener('click', () => goToPage(currentPage + 1));
    pageButtons.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-page]');
      if (button?.dataset.page) goToPage(Number(button.dataset.page));
    });
    window.addEventListener('popstate', () => {
      currentPage = pageFromUrl();
      renderPagination();
      scrollToGrid();
    });
    apply();
  </script>
</Base>
