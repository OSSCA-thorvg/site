---
const canvasId = 'gradient-aa-lab-canvas';
---

<figure class="aa-lab" data-aa-lab>
  <figcaption class="aa-lab__header">
    <strong>Repeat 경계 Anti-Aliasing</strong>
    <span data-renderer-status>초기화 중</span>
  </figcaption>

  <div class="aa-lab__stage">
    <canvas
      id={canvasId}
      width="680"
      height="240"
      aria-label="ThorVG Repeat Gradient Anti-Aliasing 결과"
    ></canvas>
  </div>

  <div class="aa-lab__definition">
    <p><strong>p1–p2 길이</strong><span>Linear Gradient의 한 반복 주기</span></p>
    <code data-margin-formula>initial margin = floor(800 / 72) = 11 entries</code>
  </div>

  <div class="aa-lab__table" aria-label="Color Table 보간 비교">
    <p class="aa-lab__section-label">Color Table 전체</p>
    <div class="aa-lab__seam-row">
      <span>적용 전</span>
      <div class="aa-lab__samples aa-lab__samples--full">
        <canvas
          id="gradient-aa-raw-full-table"
          data-full-table
          data-full-raw
          width="1024"
          height="28"
          aria-label="Anti-Aliasing 적용 전 전체 Color Table"
        ></canvas>
      </div>
    </div>
    <div class="aa-lab__seam-row">
      <span><code>_applyAA()</code></span>
      <div class="aa-lab__samples aa-lab__samples--full aa-lab__samples--applied">
        <canvas
          id="gradient-aa-applied-full-table"
          data-full-table
          data-full-aa
          width="1024"
          height="28"
          aria-label="Anti-Aliasing 적용 후 전체 Color Table"
        ></canvas>
        <i class="aa-lab__range aa-lab__range--full-end" data-full-end aria-hidden="true"></i>
        <i class="aa-lab__range aa-lab__range--full-begin" data-full-begin aria-hidden="true"></i>
      </div>
    </div>
    <div class="aa-lab__full-axis" aria-hidden="true">
      <span>ctable[0]</span>
      <i></i>
      <span>ctable[1023]</span>
    </div>

    <p class="aa-lab__section-label aa-lab__section-label--detail">Repeat 경계 확대</p>
    <div class="aa-lab__seam-row">
      <span>적용 전</span>
      <div class="aa-lab__samples">
        <canvas
          id="gradient-aa-raw-table"
          data-raw-samples
          width="576"
          height="22"
          aria-label="Anti-Aliasing 적용 전 Color Table 경계"
        ></canvas>
      </div>
    </div>
    <div class="aa-lab__seam-row">
      <span><code>_applyAA()</code></span>
      <div class="aa-lab__samples aa-lab__samples--applied">
        <canvas
          id="gradient-aa-applied-table"
          data-aa-samples
          width="576"
          height="22"
          aria-label="Anti-Aliasing 적용 후 Color Table 경계"
        ></canvas>
        <i class="aa-lab__range aa-lab__range--end" data-end-highlight aria-hidden="true"></i>
        <i class="aa-lab__range aa-lab__range--begin" data-begin-highlight aria-hidden="true"></i>
      </div>
    </div>
    <div class="aa-lab__seam-axis" aria-hidden="true">
      <span data-end-range>ctable[984…1023]</span>
      <strong>1023 → 0</strong>
      <span data-begin-range>ctable[0…39]</span>
    </div>
  </div>

  <div class="aa-lab__controls">
    <label>
      <span>p1–p2 길이 <output data-length-output>72</output></span>
      <input data-length type="range" min="24" max="320" value="72" />
    </label>
    <label>
      <span>방향 <output data-angle-output>24°</output></span>
      <input data-angle type="range" min="-60" max="60" value="24" />
    </label>
    <label>
      <span>중간 Stop <output data-offset-output>50%</output></span>
      <input data-offset type="range" min="8" max="92" value="50" />
    </label>
    <div class="aa-lab__colors" aria-label="Color Stop 색상">
      <label><span>Start</span><input data-color type="color" value="#f54842" /></label>
      <label><span>Middle</span><input data-color type="color" value="#fab737" /></label>
      <label><span>End</span><input data-color type="color" value="#2069e0" /></label>
    </div>
  </div>

  <dl class="aa-lab__metrics">
    <div><dt>initial margin</dt><dd data-estimate>11 entries</dd></div>
    <div><dt>begin margin</dt><dd data-begin>11 entries</dd></div>
    <div><dt>end margin</dt><dd data-end>11 entries</dd></div>
  </dl>

  <p class="aa-lab__note">
    전체 Color Table 아래에서
    <code>1023 → 0</code> 경계와 실제로 교체되는 margin을 확대해 비교할 수 있다.
  </p>
</figure>

<script>
  import ThorVG from '@thorvg/webcanvas';
  import wasmUrl from '../../node_modules/@thorvg/webcanvas/dist/thorvg.wasm?url';

  type Rgba = [number, number, number, number];
  type ThorVGGlobal = typeof globalThis & {
    __thorvgSwPromise?: ReturnType<typeof ThorVG.init>;
  };

  const TABLE_SIZE = 1024;
  const SAMPLE_WINDOW = 40;
  const OVERVIEW_SAMPLES = 256;
  const WIDTH = 680;
  const HEIGHT = 240;
  const thorvgGlobal = globalThis as ThorVGGlobal;
  const loadThorVG = () => thorvgGlobal.__thorvgSwPromise ??= ThorVG.init({ renderer: 'sw', locateFile: (file) => file.endsWith('.wasm') ? wasmUrl : file });

  const parseHex = (hex: string): Rgba => [
    Number.parseInt(hex.slice(1, 3), 16),
    Number.parseInt(hex.slice(3, 5), 16),
    Number.parseInt(hex.slice(5, 7), 16),
    255,
  ];

  const mix = (from: Rgba, to: Rgba, t: number): Rgba => [
    Math.round(from[0] + (to[0] - from[0]) * t),
    Math.round(from[1] + (to[1] - from[1]) * t),
    Math.round(from[2] + (to[2] - from[2]) * t),
    Math.round(from[3] + (to[3] - from[3]) * t),
  ];

  document.querySelectorAll<HTMLElement>('[data-aa-lab]').forEach((root) => {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const canvasElement = root.querySelector<HTMLCanvasElement>('canvas')!;
    const lengthInput = root.querySelector<HTMLInputElement>('[data-length]')!;
    const angleInput = root.querySelector<HTMLInputElement>('[data-angle]')!;
    const offsetInput = root.querySelector<HTMLInputElement>('[data-offset]')!;
    const colorInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-color]'));
    const rawFullTable = root.querySelector<HTMLCanvasElement>('[data-full-raw]')!;
    const aaFullTable = root.querySelector<HTMLCanvasElement>('[data-full-aa]')!;
    const rawSamples = root.querySelector<HTMLCanvasElement>('[data-raw-samples]')!;
    const aaSamples = root.querySelector<HTMLCanvasElement>('[data-aa-samples]')!;
    const fullEnd = root.querySelector<HTMLElement>('[data-full-end]')!;
    const fullBegin = root.querySelector<HTMLElement>('[data-full-begin]')!;
    const endHighlight = root.querySelector<HTMLElement>('[data-end-highlight]')!;
    const beginHighlight = root.querySelector<HTMLElement>('[data-begin-highlight]')!;
    const endRange = root.querySelector<HTMLElement>('[data-end-range]')!;
    const beginRange = root.querySelector<HTMLElement>('[data-begin-range]')!;
    const marginFormula = root.querySelector<HTMLElement>('[data-margin-formula]')!;
    const status = root.querySelector<HTMLElement>('[data-renderer-status]')!;
    const lengthOutput = root.querySelector<HTMLOutputElement>('[data-length-output]')!;
    const angleOutput = root.querySelector<HTMLOutputElement>('[data-angle-output]')!;
    const offsetOutput = root.querySelector<HTMLOutputElement>('[data-offset-output]')!;
    const estimateOutput = root.querySelector<HTMLElement>('[data-estimate]')!;
    const beginOutput = root.querySelector<HTMLElement>('[data-begin]')!;
    const endOutput = root.querySelector<HTMLElement>('[data-end]')!;

    let renderThorVG = () => {};
    let renderSamples = (_raw: Rgba[], _aa: Rgba[]) => {};

    const createTable = (colors: Rgba[], middleOffset: number) => {
      const table: Rgba[] = [];
      for (let i = 0; i < TABLE_SIZE; i += 1) {
        const position = i / (TABLE_SIZE - 1);
        if (position <= middleOffset) {
          table.push(mix(colors[0], colors[1], position / middleOffset));
        } else {
          table.push(mix(colors[1], colors[2], (position - middleOffset) / (1 - middleOffset)));
        }
      }
      return table;
    };

    const margin = (estimate: number, available: number) => Math.min(
      estimate,
      Math.floor(available * 0.1),
      40,
    );

    const applyAA = (table: Rgba[], begin: number, end: number) => {
      const result = table.map((color) => [...color] as Rgba);
      if (begin === 0 || end === 0) return result;

      const from = table[TABLE_SIZE - end];
      const to = table[begin];
      const count = begin + end;
      for (let step = 0; step < count; step += 1) {
        const index = (TABLE_SIZE - end + step) % TABLE_SIZE;
        result[index] = mix(from, to, (step + 1) / (count + 1));
      }
      return result;
    };

    const update = () => {
      const length = Number(lengthInput.value);
      const angle = Number(angleInput.value);
      const middleOffset = Number(offsetInput.value) / 100;
      const colors = colorInputs.map((input) => parseHex(input.value));
      const estimate = Math.floor(800 / length);
      const middleIndex = Math.round(middleOffset * (TABLE_SIZE - 1));
      const begin = margin(estimate, middleIndex);
      const end = margin(estimate, TABLE_SIZE - middleIndex);
      const table = createTable(colors, middleOffset);
      const aaTable = applyAA(table, begin, end);

      lengthOutput.value = String(length);
      angleOutput.value = `${angle}°`;
      offsetOutput.value = `${offsetInput.value}%`;
      estimateOutput.textContent = `${estimate} entries`;
      marginFormula.textContent = `initial margin = floor(800 / ${length}) = ${estimate} entries`;
      beginOutput.textContent = `${begin} entries`;
      endOutput.textContent = `${end} entries`;
      fullEnd.style.width = `${end / TABLE_SIZE * 100}%`;
      fullBegin.style.width = `${begin / TABLE_SIZE * 100}%`;
      endHighlight.style.width = `${Math.min(end / SAMPLE_WINDOW, 1) * 50}%`;
      beginHighlight.style.width = `${Math.min(begin / SAMPLE_WINDOW, 1) * 50}%`;
      endRange.textContent = `ctable[${TABLE_SIZE - SAMPLE_WINDOW}…${TABLE_SIZE - 1}]`;
      beginRange.textContent = `ctable[0…${SAMPLE_WINDOW - 1}]`;
      renderThorVG();
      renderSamples(table, aaTable);
    };

    [...root.querySelectorAll<HTMLInputElement>('input')].forEach((input) => {
      input.addEventListener('input', update);
    });

    update();

    loadThorVG().then((TVG) => {
      const canvas = new TVG.Canvas(`#${canvasElement.id}`, {
        width: WIDTH,
        height: HEIGHT,
        enableDevicePixelRatio: false,
      });
      const rawFullCanvas = new TVG.Canvas(`#${rawFullTable.id}`, {
        width: rawFullTable.width,
        height: rawFullTable.height,
        enableDevicePixelRatio: false,
      });
      const aaFullCanvas = new TVG.Canvas(`#${aaFullTable.id}`, {
        width: aaFullTable.width,
        height: aaFullTable.height,
        enableDevicePixelRatio: false,
      });
      const rawCanvas = new TVG.Canvas(`#${rawSamples.id}`, {
        width: rawSamples.width,
        height: rawSamples.height,
        enableDevicePixelRatio: false,
      });
      const aaCanvas = new TVG.Canvas(`#${aaSamples.id}`, {
        width: aaSamples.width,
        height: aaSamples.height,
        enableDevicePixelRatio: false,
      });
      let currentShape: InstanceType<typeof TVG.Shape> | undefined;
      let currentRawFull: InstanceType<typeof TVG.Scene> | undefined;
      let currentAAFull: InstanceType<typeof TVG.Scene> | undefined;
      let currentRaw: InstanceType<typeof TVG.Scene> | undefined;
      let currentAA: InstanceType<typeof TVG.Scene> | undefined;

      const drawTable = (
        target: InstanceType<typeof TVG.Canvas>,
        current: InstanceType<typeof TVG.Scene> | undefined,
        table: Rgba[],
        element: HTMLCanvasElement,
        indices: number[],
      ) => {
        if (current) {
          target.remove(current);
          current.dispose();
        }

        const scene = new TVG.Scene();
        const cellWidth = element.width / indices.length;
        for (let index = 0; index < indices.length; index += 1) {
          const color = table[indices[index]];
          const cell = new TVG.Shape()
            .appendRect(index * cellWidth, 0, cellWidth + 0.5, element.height)
            .fill(...color);
          scene.add(cell);
        }

        target.add(scene).render();
        return scene;
      };

      renderSamples = (rawTable, aaTable) => {
        const overviewIndices = Array.from(
          { length: OVERVIEW_SAMPLES },
          (_, index) => Math.floor(index * TABLE_SIZE / OVERVIEW_SAMPLES),
        );
        const boundaryIndices = Array.from(
          { length: SAMPLE_WINDOW * 2 },
          (_, index) => index < SAMPLE_WINDOW
            ? TABLE_SIZE - SAMPLE_WINDOW + index
            : index - SAMPLE_WINDOW,
        );

        currentRawFull = drawTable(rawFullCanvas, currentRawFull, rawTable, rawFullTable, overviewIndices);
        currentAAFull = drawTable(aaFullCanvas, currentAAFull, aaTable, aaFullTable, overviewIndices);
        currentRaw = drawTable(rawCanvas, currentRaw, rawTable, rawSamples, boundaryIndices);
        currentAA = drawTable(aaCanvas, currentAA, aaTable, aaSamples, boundaryIndices);
      };

      renderThorVG = () => {
        if (currentShape) {
          canvas.remove(currentShape);
          currentShape.dispose();
        }

        const length = Number(lengthInput.value);
        const angle = Number(angleInput.value) * Math.PI / 180;
        const middleOffset = Number(offsetInput.value) / 100;
        const colors = colorInputs.map((input) => parseHex(input.value));
        const dx = Math.cos(angle) * length * 0.5;
        const dy = Math.sin(angle) * length * 0.5;
        const gradient = new TVG.LinearGradient(
          WIDTH / 2 - dx,
          HEIGHT / 2 - dy,
          WIDTH / 2 + dx,
          HEIGHT / 2 + dy,
        ).setStops(
          [0.0, colors[0]],
          [middleOffset, colors[1]],
          [1.0, colors[2]],
        );

        gradient.spread(TVG.GradientSpread.Repeat);
        currentShape = new TVG.Shape().appendRect(0, 0, WIDTH, HEIGHT).fill(gradient);
        canvas.add(currentShape).render();
      };

      root.classList.add('is-ready');
      status.textContent = 'ThorVG CPU Engine';
      update();
    }).catch((error) => {
      console.error('ThorVG Gradient AA lab initialization failed', error);
      root.classList.add('has-error');
      status.textContent = '렌더링 실패';
    });
  });
</script>

<style>
  .aa-lab {
    margin: var(--space-lg) 0 var(--space-xl);
    overflow: hidden;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    color: var(--ink);
  }

  .aa-lab__header {
    min-height: 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 7px var(--space-md);
    border-bottom: 1px solid var(--hairline);
  }

  .aa-lab__header strong,
  .aa-lab__header span,
  .aa-lab__seam-row > span,
  .aa-lab__seam-axis,
  .aa-lab__full-axis,
  .aa-lab__section-label,
  .aa-lab__definition,
  .aa-lab__controls span,
  .aa-lab__metrics,
  .aa-lab__note {
    font-size: 12px;
    line-height: 1.35;
  }

  .aa-lab__header strong {
    font-weight: 600;
  }

  .aa-lab__header span,
  .aa-lab__seam-axis,
  .aa-lab__full-axis,
  .aa-lab__metrics dt,
  .aa-lab__note {
    color: var(--ink-subtle);
  }

  .aa-lab__stage {
    position: relative;
    background: var(--surface-2);
  }

  .aa-lab__stage canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 17 / 6;
  }

  .aa-lab__definition {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 10px var(--space-md);
    border-top: 1px solid var(--hairline);
    background: var(--canvas);
  }

  .aa-lab__definition p {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
  }

  .aa-lab__definition p span {
    color: var(--ink-subtle);
  }

  .aa-lab__definition code {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .aa-lab__table {
    padding: var(--space-md);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    background: var(--canvas);
  }

  .aa-lab__section-label {
    margin: 0 0 8px;
    color: var(--ink-muted);
    font-weight: 600;
  }

  .aa-lab__section-label--detail {
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--hairline);
  }

  .aa-lab__seam-row {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    align-items: center;
    gap: var(--space-sm);
  }

  .aa-lab__seam-row + .aa-lab__seam-row {
    margin-top: 8px;
  }

  .aa-lab__seam-row code,
  .aa-lab__note code {
    font-family: var(--font-mono);
    font-size: 0.95em;
  }

  .aa-lab__samples {
    position: relative;
    height: 22px;
    overflow: hidden;
    border: 1px solid var(--hairline-strong);
    border-radius: 4px;
  }

  .aa-lab__samples--full {
    height: 28px;
  }

  .aa-lab__samples--full::after {
    display: none;
  }

  .aa-lab__samples::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    border-left: 1px solid rgba(255, 255, 255, 0.9);
  }

  .aa-lab__samples canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .aa-lab__range {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    width: 0;
    pointer-events: none;
    background: color-mix(in srgb, var(--primary) 16%, transparent);
  }

  .aa-lab__range--full-end {
    right: 0;
    border-left: 2px solid var(--primary);
  }

  .aa-lab__range--full-begin {
    left: 0;
    border-right: 2px solid var(--primary);
  }

  .aa-lab__range--end {
    right: 50%;
    border-left: 2px solid var(--primary);
  }

  .aa-lab__range--begin {
    left: 50%;
    border-right: 2px solid var(--primary);
  }

  .aa-lab__full-axis,
  .aa-lab__seam-axis {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 8px;
    margin: 6px 0 0 100px;
  }

  .aa-lab__full-axis span:first-child,
  .aa-lab__seam-axis span:first-child {
    text-align: left;
  }

  .aa-lab__full-axis span:last-child,
  .aa-lab__seam-axis span:last-child {
    text-align: right;
  }

  .aa-lab__full-axis i {
    width: 1px;
    height: 10px;
    background: var(--hairline-strong);
  }

  .aa-lab__seam-axis {
    align-items: center;
  }

  .aa-lab__seam-axis strong {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
  }

  .aa-lab__controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
    padding: var(--space-md);
  }

  .aa-lab__controls > label {
    display: grid;
    gap: 7px;
  }

  .aa-lab__controls label > span {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: var(--ink-muted);
  }

  .aa-lab__controls output {
    color: var(--ink);
    font-family: var(--font-mono);
  }

  .aa-lab__controls input[type='range'] {
    width: 100%;
    accent-color: var(--primary);
  }

  .aa-lab__colors {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--hairline);
  }

  .aa-lab__colors label {
    display: grid;
    grid-template-columns: 1fr 40px;
    align-items: center;
    gap: 8px;
  }

  .aa-lab__colors input[type='color'] {
    width: 40px;
    height: 28px;
    padding: 2px;
    border: 1px solid var(--control-border);
    border-radius: 4px;
    background: var(--canvas);
  }

  .aa-lab__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 10px var(--space-md);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .aa-lab__metrics div {
    min-width: 0;
  }

  .aa-lab__metrics div + div {
    padding-left: var(--space-md);
    border-left: 1px solid var(--hairline);
  }

  .aa-lab__metrics dt,
  .aa-lab__metrics dd {
    margin: 0;
  }

  .aa-lab__metrics dd {
    margin-top: 2px;
    font-family: var(--font-mono);
  }

  .aa-lab__note {
    margin: 0;
    padding: 10px var(--space-md);
  }

  @media (max-width: 560px) {
    .aa-lab__header {
      align-items: flex-start;
      flex-direction: column;
    }

    .aa-lab__definition,
    .aa-lab__definition p {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }

    .aa-lab__seam-row {
      grid-template-columns: 1fr;
      gap: 5px;
    }

    .aa-lab__full-axis,
    .aa-lab__seam-axis {
      margin-left: 0;
    }

    .aa-lab__controls,
    .aa-lab__colors {
      grid-template-columns: 1fr;
    }

    .aa-lab__colors {
      grid-column: auto;
    }

    .aa-lab__metrics {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .aa-lab__metrics div + div {
      padding: 8px 0 0;
      border-top: 1px solid var(--hairline);
      border-left: 0;
    }
  }
</style>
