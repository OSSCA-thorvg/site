---
interface Props {
  name: string;
  embedded?: boolean;
}

const { name, embedded = false } = Astro.props;
---

<details class:list={['mentoring-member', { 'is-embedded': embedded }]}>
  <summary>{name}</summary>
  <div class="mentoring-member__body">
    <slot />
  </div>
</details>

<style>
  .mentoring-member {
    width: 100%;
    border-top: 1px solid var(--hairline);
  }

  .mentoring-member:last-of-type {
    border-bottom: 1px solid var(--hairline);
  }

  .mentoring-member.is-embedded {
    border: 0;
  }

  .mentoring-member > summary {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 52px;
    padding: var(--space-sm) 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  .mentoring-member > summary::-webkit-details-marker {
    display: none;
  }

  .mentoring-member > summary::before {
    content: '›';
    flex: none;
    color: var(--ink-subtle);
    font-size: 18px;
    font-weight: 400;
    transform: rotate(0deg);
    transition: transform 160ms ease;
  }

  .mentoring-member[open] > summary::before {
    transform: rotate(90deg);
  }

  .mentoring-member > summary:hover {
    color: var(--primary-hover);
  }

  .mentoring-member > summary:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .mentoring-member.is-embedded > summary {
    display: inline-flex;
    gap: var(--space-xs);
    min-height: 32px;
    padding: var(--space-xxs) 0;
    color: var(--primary);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
  }

  .mentoring-member.is-embedded > summary::before {
    font-size: 15px;
  }

  .mentoring-member__body {
    padding: 0 0 var(--space-lg) var(--space-lg);
  }

  .mentoring-member.is-embedded > .mentoring-member__body {
    padding: var(--space-xs) 0 var(--space-md);
  }

  @media (max-width: 520px) {
    .mentoring-member:not(.is-embedded) > .mentoring-member__body {
      padding-left: var(--space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mentoring-member > summary::before {
      transition: none;
    }
  }
</style>
