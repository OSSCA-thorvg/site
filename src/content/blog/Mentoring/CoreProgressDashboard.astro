---
type PullRequestState = 'merged' | 'open' | 'closed';
type ActivityKind = 'issue' | 'pullRequest';

type LinkItem = {
  number: number;
  title: string;
  url: string;
  kind: ActivityKind;
  state?: PullRequestState;
};

type Member = {
  name: string;
  profile: string;
  issues: LinkItem[];
  pullRequests: LinkItem[];
  participation: LinkItem[];
};

type Metric = {
  label: string;
  value: number;
  items: LinkItem[];
  className: string;
  detail?: string;
};

type MetricGroup = {
  label: string;
  className: string;
  metrics: Metric[];
};

const activityTitles: Record<string, string> = {
  'issue:29': 'cpu: AVX optimization',
  'issue:1758': 'gif: a broken gif conversion',
  'issue:3788': 'text: support ttc extension',
  'issue:4174': 'renderer: Support actual font face name instead of font file name',
  'issue:4349': 'lottie: revise bezier interpolator',
  'issue:4426': 'gl_engine: blur shader optimization',
  'issue:4446': 'lottie: layer effect dropped by JSON key order',
  'issue:4497': 'common: support build-time log level selection',
  'issue:4547': 'infra: binary size workflow not working on wg_engine',
  'issue:4577': 'wgpu: unrendered regions make the window transparent on Windows (MSYS2)',
  'issue:4591': "doc: ambiguous 'default value' phrasing in docs",
  'issue:4601': 'proposal: Detect struct byte padding during build',
  'issue:4605': 'SVG: nullptr crash parsing a css @font-face with no trailing ;',
  'issue:4618': 'clean up compiler padding warnings',
  'issue:4621': 'svg: Speed up color lookup with binary search',
  'issue:4641': 'svg: Clarify null separator handling for invalid style declarations',
  'issue:4642': 'svg: refactor named color assignment',
  'issue:4669': 'gif: Some parts of the visual colors are still not encoded correctly.',
  'issue:4688': 'cpu: repeat-gradient anti-aliasing ignores transform',
  'issue:4698': 'infra: build fails when asan is enabled (MSYS2)',
  'issue:4703': 'optimize struct memory usage',
  'pullRequest:4576': 'doc: fix incorrect alpha default value in fill()/strokeFill() description',
  'pullRequest:4586': 'doc: fix incorrect current point description in appendRect()',
  'pullRequest:4590': 'Revert "doc: fix incorrect alpha default value in fill()/strokeFill() description"',
  'pullRequest:4603': 'infra: enable the wg engine in the binary size workflow',
  'pullRequest:4609': 'svg/parser: Prevent a crash in font-face declarations',
  'pullRequest:4620': 'Wpadded warnings clean up',
  'pullRequest:4640': 'svg: optimize named color lookup with binary search',
  'pullRequest:4653': 'wg_engine: fix compiler warning for WgStageBufferSolidColor',
  'pullRequest:4655': 'savers/gif: fix broken gif palette creation',
  'pullRequest:4685': 'savers/gif: separate color quantization from the palette search structure',
  'pullRequest:4697': 'gl: optimize Gaussian blur weight calculation',
  'pullRequest:4710': 'cpu_engine: allow subpixel-aligned axis-aligned rects',
  'pullRequest:4721': 'lottie: fix layer effects dropped by JSON key order',
};

const titleFor = (kind: ActivityKind, number: number) => activityTitles[`${kind}:${number}`];

const issue = (number: number, state?: 'open' | 'closed'): LinkItem => ({
  number,
  title: titleFor('issue', number),
  url: `https://github.com/thorvg/thorvg/issues/${number}`,
  kind: 'issue',
  state,
});

const pull = (number: number, state?: PullRequestState): LinkItem => ({
  number,
  title: titleFor('pullRequest', number),
  url: `https://github.com/thorvg/thorvg/pull/${number}`,
  kind: 'pullRequest',
  state,
});

const members: Member[] = [
  {
    name: 'alpakaDurumi',
    profile: 'https://github.com/alpakaDurumi',
    issues: [issue(4698, 'open'), issue(4591, 'closed'), issue(4577, 'open')],
    pullRequests: [
      pull(4721, 'open'),
      pull(4710, 'open'),
      pull(4685, 'merged'),
      pull(4655, 'merged'),
      pull(4603, 'merged'),
      pull(4590, 'closed'),
      pull(4586, 'merged'),
      pull(4576, 'merged'),
    ],
    participation: [
      issue(4688),
      issue(4669),
      issue(4547),
      issue(4497),
      issue(4446),
      issue(4174),
      issue(3788),
      issue(1758),
    ],
  },
  {
    name: 'J-unStiN',
    profile: 'https://github.com/J-unStiN',
    issues: [issue(4601, 'open'), issue(4621, 'closed')],
    pullRequests: [pull(4620, 'open'), pull(4640, 'merged')],
    participation: [issue(4642), issue(4618)],
  },
  {
    name: 'jeongsunyong',
    profile: 'https://github.com/jeongsunyong',
    issues: [issue(4641, 'closed')],
    pullRequests: [pull(4609, 'merged')],
    participation: [issue(4605)],
  },
  {
    name: 'DaengDo',
    profile: 'https://github.com/DaengDo',
    issues: [],
    pullRequests: [pull(4653, 'merged')],
    participation: [issue(4349)],
  },
  {
    name: 'Saususge',
    profile: 'https://github.com/Saususge',
    issues: [],
    pullRequests: [pull(4697, 'closed')],
    participation: [issue(4426), issue(29)],
  },
  {
    name: 'tcpark11',
    profile: 'https://github.com/tcpark11',
    issues: [],
    pullRequests: [],
    participation: [issue(4703), issue(4618)],
  },
];

const uniqueItems = (items: LinkItem[]) => [...new Map(items.map((item) => [item.url, item])).values()];

const memberStats = members.map((member) => {
  const relatedIssueItems = uniqueItems(member.participation.filter(({ kind }) => kind === 'issue'));
  const pullRequestItems = uniqueItems([
    ...member.pullRequests,
    ...member.participation.filter(({ kind }) => kind === 'pullRequest'),
  ]);
  const openIssueItems = member.issues.filter(({ state }) => state === 'open');
  const closedIssueItems = member.issues.filter(({ state }) => state === 'closed');
  const issueItems = uniqueItems([...member.issues, ...relatedIssueItems]);
  const participatedIssueItems = issueItems;
  const openPullRequestItems = pullRequestItems.filter(({ state }) => state === 'open');
  const mergedPullRequestItems = pullRequestItems.filter(({ state }) => state === 'merged');
  const closedPullRequestItems = pullRequestItems.filter(({ state }) => state === 'closed');
  const totalItems = [...issueItems, ...pullRequestItems];

  return {
    ...member,
    openIssueItems,
    closedIssueItems,
    participatedIssueItems,
    openPullRequestItems,
    mergedPullRequestItems,
    closedPullRequestItems,
    issueItems,
    pullRequestItems,
    totalItems,
    openIssues: openIssueItems.length,
    closedIssues: closedIssueItems.length,
    participatedIssues: participatedIssueItems.length,
    openPullRequests: openPullRequestItems.length,
    mergedPullRequests: mergedPullRequestItems.length,
    closedPullRequests: closedPullRequestItems.length,
    totalIssues: issueItems.length,
    totalPullRequests: pullRequestItems.length,
    total: totalItems.length,
  };
});

const totalOpenIssueItems = uniqueItems(memberStats.flatMap(({ openIssueItems }) => openIssueItems));
const totalClosedIssueItems = uniqueItems(memberStats.flatMap(({ closedIssueItems }) => closedIssueItems));
const totalParticipatedIssueItems = uniqueItems(memberStats.flatMap(({ participatedIssueItems }) => participatedIssueItems));
const totalOpenPullRequestItems = uniqueItems(memberStats.flatMap(({ openPullRequestItems }) => openPullRequestItems));
const totalMergedPullRequestItems = uniqueItems(memberStats.flatMap(({ mergedPullRequestItems }) => mergedPullRequestItems));
const totalClosedPullRequestItems = uniqueItems(memberStats.flatMap(({ closedPullRequestItems }) => closedPullRequestItems));
const totalIssueItems = uniqueItems(memberStats.flatMap(({ issueItems }) => issueItems));
const totalPullRequestItems = uniqueItems(memberStats.flatMap(({ pullRequestItems }) => pullRequestItems));
const totalItems = [...totalIssueItems, ...totalPullRequestItems];

const totals = {
  openIssues: totalOpenIssueItems.length,
  closedIssues: totalClosedIssueItems.length,
  participatedIssues: totalParticipatedIssueItems.length,
  openPullRequests: totalOpenPullRequestItems.length,
  mergedPullRequests: totalMergedPullRequestItems.length,
  closedPullRequests: totalClosedPullRequestItems.length,
  totalIssues: totalIssueItems.length,
  totalPullRequests: totalPullRequestItems.length,
  total: totalItems.length,
};

const summaryGroups: MetricGroup[] = [
  {
    label: 'Issue',
    className: 'is-issue-group',
    metrics: [
      { label: 'Open', value: totals.openIssues, items: totalOpenIssueItems, className: 'is-open' },
      { label: 'Closed', value: totals.closedIssues, items: totalClosedIssueItems, className: 'is-closed' },
      { label: '참여', value: totals.participatedIssues, items: totalParticipatedIssueItems, className: 'is-participated' },
    ],
  },
  {
    label: 'PR',
    className: 'is-pr-group',
    metrics: [
      { label: 'Open', value: totals.openPullRequests, items: totalOpenPullRequestItems, className: 'is-open' },
      { label: 'Closed', value: totals.closedPullRequests, items: totalClosedPullRequestItems, className: 'is-closed' },
      { label: 'Merged', value: totals.mergedPullRequests, items: totalMergedPullRequestItems, className: 'is-merged' },
      { label: 'Total', value: totals.totalPullRequests, items: totalPullRequestItems, className: 'is-total' },
    ],
  },
  {
    label: 'TOTAL',
    className: 'is-total-group',
    metrics: [
      { label: 'Issue + PR', value: totals.total, items: totalItems, className: 'is-total', detail: `${totals.totalIssues} Issues + ${totals.totalPullRequests} PRs` },
    ],
  },
];

const memberDetails = new Map<string, string>();

for (const member of memberStats) {
  if (Astro.slots.has(member.name)) {
    memberDetails.set(member.name, await Astro.slots.render(member.name));
  }
}
---

<section class="core-board" aria-labelledby="core-board-title">
  <header class="core-board__header">
    <div>
      <p class="core-board__eyebrow">CORE / 2026-08-29</p>
      <h3 id="core-board-title">Core 진행사항</h3>
    </div>
    <span class="core-board__status"><span aria-hidden="true"></span> GitHub sync · 2026-08-29</span>
  </header>

  <div class="core-board__metrics" aria-label="기여 현황 요약">
    {summaryGroups.map((group) => (
      <section class:list={['metric-group', group.className]} aria-label={`${group.label} 통계`}>
        <h4>{group.label}</h4>
        <div class="metric-group__items">
          {group.metrics.map((metric) => (
            <div
              class:list={['core-metric', metric.className]}
              tabindex="0"
              aria-label={`${group.label} ${metric.label} ${metric.value}건. 항목 목록 열기`}
            >
              <span>{metric.label}</span>
              <strong>{metric.value}</strong>
              {metric.detail && <small>{metric.detail}</small>}
              <div class="activity-popover" aria-label={`${group.label} ${metric.label} 항목`}>
                <p>{group.label} · {metric.label} <b>{metric.value}</b></p>
                <ul>
                  {metric.items.map((item) => (
                    <li><a href={item.url}><span>#{item.number}</span>{item.title}</a></li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>

  <div class="core-board__members">
    {memberStats.map((member) => (
        <article class="member-card">
          <header class="member-card__header">
            <a class="member-card__avatar-link" href={member.profile} aria-label={`${member.name} GitHub 프로필`}>
              <img
                class="member-card__avatar"
                src={`https://github.com/${member.name}.png?size=80`}
                alt=""
                width="32"
                height="32"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </a>
            <h4><a href={member.profile}>{member.name}</a></h4>
          </header>

          <div class="member-card__stats" aria-label={`${member.name} 기여 집계`}>
            {([
              {
                label: 'Issue',
                className: 'is-issue-group',
                metrics: [
                  { label: 'Open', value: member.openIssues, items: member.openIssueItems, className: 'is-open' },
                  { label: 'Closed', value: member.closedIssues, items: member.closedIssueItems, className: 'is-closed' },
                  { label: '참여', value: member.participatedIssues, items: member.participatedIssueItems, className: 'is-participated' },
                ],
              },
              {
                label: 'PR',
                className: 'is-pr-group',
                metrics: [
                  { label: 'Open', value: member.openPullRequests, items: member.openPullRequestItems, className: 'is-open' },
                  { label: 'Closed', value: member.closedPullRequests, items: member.closedPullRequestItems, className: 'is-closed' },
                  { label: 'Merged', value: member.mergedPullRequests, items: member.mergedPullRequestItems, className: 'is-merged' },
                  { label: 'Total', value: member.totalPullRequests, items: member.pullRequestItems, className: 'is-total' },
                ],
              },
              {
                label: 'TOTAL',
                className: 'is-total-group',
                metrics: [
                  { label: 'Issue + PR', value: member.total, items: member.totalItems, className: 'is-total', detail: `${member.totalIssues} Issue + ${member.totalPullRequests} PR` },
                ],
              },
            ] as MetricGroup[]).map((group) => (
              <section class:list={['member-stat-group', group.className]} aria-label={`${member.name} ${group.label} 통계`}>
                <h5>{group.label}</h5>
                <div class="member-stat-group__items">
                  {group.metrics.map((metric) => (
                    <div
                      class:list={['member-stat', metric.className]}
                      tabindex="0"
                      aria-label={`${member.name} ${group.label} ${metric.label} ${metric.value}건. 항목 목록 열기`}
                    >
                      <span>{metric.label}</span>
                      <strong>{metric.value}</strong>
                      {metric.detail && <small>{metric.detail}</small>}
                      <div class="activity-popover" aria-label={`${member.name} ${group.label} ${metric.label} 항목`}>
                        <p>{group.label} · {metric.label} <b>{metric.value}</b></p>
                        {metric.items.length > 0 ? (
                          <ul>
                            {metric.items.map((item) => (
                              <li><a href={item.url}><span>#{item.number}</span>{item.title}</a></li>
                            ))}
                          </ul>
                        ) : <p class="activity-popover__empty">항목 없음</p>}
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            ))}
          </div>

          {memberDetails.has(member.name) && (
            <div class="member-card__detail" set:html={memberDetails.get(member.name)} />
          )}
        </article>
    ))}
  </div>
</section>

<style>
  .core-board {
    width: 100%;
    margin: var(--space-lg) 0 var(--space-xxl);
    color: var(--ink);
    border-block: 1px solid var(--hairline-strong);
  }

  .core-board__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }

  .core-board__eyebrow {
    margin: 0;
  }

  .core-board__eyebrow {
    color: var(--primary);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .core-board h3 {
    margin: var(--space-xs) 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .core-board__status {
    display: inline-flex;
    align-items: center;
    flex: none;
    gap: var(--space-xs);
    min-height: 32px;
    padding: 5px 10px;
    color: var(--ink-subtle);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
  }

  .core-board__status > span {
    width: 6px;
    height: 6px;
    background: var(--status-draft);
    border-radius: 50%;
  }

  .core-board__metrics {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(110px, 1.35fr);
    border-block: 1px solid var(--hairline);
  }

  .metric-group {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-width: 0;
    border-right: 1px solid var(--hairline);
  }

  .metric-group:last-child { border-right: 0; }

  .metric-group > h4 {
    display: flex;
    align-items: center;
    margin: 0;
    min-height: 34px;
    padding: var(--space-xs) var(--space-sm);
    color: var(--ink-subtle);
    border-bottom: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .metric-group__items,
  .member-stat-group__items {
    display: grid;
    min-width: 0;
  }

  .is-issue-group .metric-group__items,
  .is-issue-group .member-stat-group__items { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .is-pr-group .metric-group__items,
  .is-pr-group .member-stat-group__items { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .is-total-group .metric-group__items,
  .is-total-group .member-stat-group__items { grid-template-columns: minmax(0, 1fr); }

  .core-metric {
    position: relative;
    display: grid;
    min-height: 104px;
    padding: var(--space-md);
    border-right: 1px solid var(--hairline);
    cursor: help;
    outline: none;
  }

  .core-metric:focus-visible,
  .member-stat:focus-visible {
    box-shadow: inset 0 0 0 2px var(--primary);
  }

  .core-metric:last-child { border-right: 0; }
  .core-metric span { color: var(--ink-subtle); font-size: 12px; font-weight: 500; }
  .core-metric strong {
    align-self: end;
    color: var(--state-color, var(--ink));
    font-family: var(--font-mono);
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .core-metric small {
    margin-top: var(--space-xxs);
    color: var(--ink-subtle);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .is-participated { --state-color: var(--cat-azure); }
  .is-merged { --state-color: var(--status-merged); }
  .is-open { --state-color: var(--status-open); }
  .is-closed { --state-color: var(--status-closed); }
  .is-total { --state-color: var(--ink); }

  .core-board__members {
    display: grid;
    grid-template-columns: 1fr;
  }

  .member-card {
    display: grid;
    grid-template-columns: minmax(150px, 0.55fr) minmax(0, 1.45fr);
    gap: var(--space-md);
    align-items: start;
    min-width: 0;
    padding-block: var(--space-md);
    border-top: 1px solid var(--hairline);
  }

  .member-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-width: 0;
  }

  .member-card__avatar-link {
    flex: none;
    border-radius: 50%;
  }

  .member-card__avatar {
    display: block;
    width: 32px;
    height: 32px;
    background: var(--surface-2);
    border-radius: 50%;
  }

  .member-card h4 { margin: 0; font-family: var(--font-display); font-size: 15px; font-weight: 600; line-height: 1.3; }
  .member-card h4 a { color: var(--ink); text-decoration: none; }
  .member-card h4 a:hover { color: var(--primary-hover); }

  .member-card__detail {
    grid-column: 2;
    min-width: 0;
  }

  .member-card__stats {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(82px, 1.35fr);
    min-width: 0;
  }

  .member-stat-group {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-width: 0;
    border-right: 1px solid var(--hairline);
  }

  .member-stat-group:last-child { border-right: 0; }

  .member-stat-group > h5 {
    display: flex;
    align-items: center;
    margin: 0;
    min-height: 24px;
    padding: 3px var(--space-xs);
    color: var(--ink-faint);
    border-bottom: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .member-stat {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-xs);
    min-width: 0;
    min-height: 42px;
    padding: var(--space-xs) var(--space-sm);
    border-right: 1px solid var(--hairline);
    cursor: help;
    outline: none;
  }

  .member-stat:last-child { border-right: 0; }

  .member-stat span { color: var(--ink-subtle); font-size: 11px; }
  .member-stat strong {
    color: var(--state-color, var(--ink));
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .member-stat small {
    grid-column: 1 / -1;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .activity-popover {
    position: absolute;
    z-index: 20;
    top: calc(100% - 4px);
    left: var(--space-sm);
    width: min(380px, calc(100vw - 40px));
    max-height: 300px;
    padding: var(--space-sm);
    overflow-y: auto;
    color: var(--ink);
    background: var(--surface-1);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md);
    box-shadow: 0 14px 32px rgb(0 0 0 / 14%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity 120ms ease, transform 120ms ease, visibility 120ms ease;
  }

  .core-metric:hover .activity-popover,
  .core-metric:focus-within .activity-popover,
  .member-stat:hover .activity-popover,
  .member-stat:focus-within .activity-popover {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .is-pr-group .metric-group__items > :last-child .activity-popover,
  .is-total-group .metric-group__items > :last-child .activity-popover,
  .is-pr-group .member-stat-group__items > :last-child .activity-popover,
  .is-total-group .member-stat-group__items > :last-child .activity-popover {
    right: var(--space-sm);
    left: auto;
  }

  .activity-popover p {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    margin: 0 0 var(--space-xs);
    color: var(--ink-subtle);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
  }

  .activity-popover p b {
    color: var(--state-color, var(--ink));
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .activity-popover ul {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .activity-popover li {
    margin: 0;
    padding: 0;
  }

  .activity-popover a {
    display: grid;
